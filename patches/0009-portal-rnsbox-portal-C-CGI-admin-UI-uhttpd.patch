 	# --- regenerate + apply ---
 	regen_dnsmasq
 	regen_nftables
 
-	nft flush ruleset 2>/dev/null
-	if [ -r "$NFT_FILE" ]; then
-		nft -f "$NFT_FILE"
+	if apply_nftables; then

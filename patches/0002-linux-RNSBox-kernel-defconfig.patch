 CONFIG_INET=y
 # CONFIG_INET_DIAG is not set
 # CONFIG_IPV6 is not set
-CONFIG_CFG80211=m
+# RNSBox W variant: AIC8800 is a fullmac (cfg80211) SDIO chip. cfg80211 is
+# BUILT-IN (=y, not =m) so its EXPORT_SYMBOLs land in the kernel
+# Module.symvers that the out-of-tree aic8800_fdrv modpost reads — otherwise
+# fdrv fails modpost with undefined cfg80211_* symbols. Built-in also removes
+# load-order fragility (cfg80211 always present before aic8800 insmod).
+# No mac80211 (firmware does the MAC).
+CONFIG_CFG80211=y
 CONFIG_RFKILL=y
 CONFIG_UEVENT_HELPER=y

diff --git a/buildroot/package/python-urwid/python-urwid.mk b/buildroot/package/python-urwid/python-urwid.mk
index 78b369ef8..b289057f0 100644
--- a/buildroot/package/python-urwid/python-urwid.mk
+++ b/buildroot/package/python-urwid/python-urwid.mk
@@ -4,11 +4,26 @@
 #
 ################################################################################
 
-PYTHON_URWID_VERSION = 2.1.2
+# RNSBox: bumped 2.1.2 -> 2.6.16 because nomadnet 1.0.4 requires urwid>=2.6.16.
+# 2.6 needs setuptools-scm at build time; without it as a host dep the
+# urwid setup.py tries `pip wheel setuptools_scm[toml]>=7.0` which fails
+# offline. Adding host-python-setuptools-scm to DEPENDENCIES fixes it.
+PYTHON_URWID_VERSION = 2.6.16
 PYTHON_URWID_SOURCE = urwid-$(PYTHON_URWID_VERSION).tar.gz
-PYTHON_URWID_SITE = https://files.pythonhosted.org/packages/94/3f/e3010f4a11c08a5690540f7ebd0b0d251cc8a456895b7e49be201f73540c
+PYTHON_URWID_SITE = https://files.pythonhosted.org/packages/98/21/ad23c9e961b2d36d57c63686a6f86768dd945d406323fb58c84f09478530
 PYTHON_URWID_LICENSE = LGPL-2.1+
 PYTHON_URWID_LICENSE_FILES = COPYING
 PYTHON_URWID_SETUP_TYPE = setuptools
+# Runtime deps urwid 2.6.x imports unguarded (not just under TYPE_CHECKING):
+#   - wcwidth          : `import wcwidth` in str_util.py
+#   - typing_extensions: top-level `from typing_extensions import Protocol,
+#                        runtime_checkable` in widget/listbox.py:29 +
+#                        widget/scrollable.py:28 (both core widgets nomadnet
+#                        uses). Most other urwid typing_extensions imports ARE
+#                        guarded by `if TYPE_CHECKING:`, but these two are not.
+# Without either, nomadnet dies at startup with ModuleNotFoundError.
+# host-python-setuptools-scm is build-time only (urwid's version at build).
+PYTHON_URWID_DEPENDENCIES = host-python-setuptools-scm python-wcwidth python-typing-extensions
+PYTHON_URWID_ENV += SETUPTOOLS_SCM_PRETEND_VERSION=$(PYTHON_URWID_VERSION)
 
 $(eval $(python-package))

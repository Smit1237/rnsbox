diff --git a/buildroot/package/libffi/0004-tramp-declare-open_temp_exec_file.patch b/buildroot/package/libffi/0004-tramp-declare-open_temp_exec_file.patch
new file mode 100644
index 000000000..1b0ca2037
--- /dev/null
+++ b/buildroot/package/libffi/0004-tramp-declare-open_temp_exec_file.patch
@@ -0,0 +1,25 @@
+tramp: forward-declare open_temp_exec_file
+
+libffi 3.4.4's tramp.c calls open_temp_exec_file() (defined extern in
+closures.c) without a prototype. Newer glibc/gcc treats implicit function
+declarations as a hard error, so the host build fails on Debian trixie
+(glibc 2.41) and similar modern distros.
+
+Upstream fixed this in 3.4.5; backport the one-line declaration here.
+
+Signed-off-by: smit1237 <smit1237@gmail.com>
+
+--- a/src/tramp.c
++++ b/src/tramp.c
+@@ -125,6 +125,11 @@ struct tramp
+   struct tramp_parm *parm;
+ };
+
++/* Defined in closures.c. Forward-declared here because libffi 3.4.4 forgot
++   to expose this prototype, and newer glibc (2.34+) compiles with
++   -Wimplicit-function-declaration as a hard error. */
++extern int open_temp_exec_file (void);
++
+ enum tramp_globals_status {
+ 	TRAMP_GLOBALS_UNINITIALIZED = 0,
+ 	TRAMP_GLOBALS_PASSED,

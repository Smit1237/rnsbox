diff --git a/buildroot/package/python-cryptography/python-cryptography.mk b/buildroot/package/python-cryptography/python-cryptography.mk
index 07c88ec3d..c0ea84a8d 100644
--- a/buildroot/package/python-cryptography/python-cryptography.mk
+++ b/buildroot/package/python-cryptography/python-cryptography.mk
@@ -2,19 +2,78 @@
 #
 # python-cryptography
 #
+# RNSBox: bumped 3.4.8 → 43.0.3 once we got host-rust (source build) working
+# for riscv64gc-unknown-linux-musl. 43.0.3 is the last release that still
+# compiles with Rust 1.71.1 (44+ bumps the minimum to 1.74). 43.0.3 works
+# cleanly against OpenSSL 3.x — no FIPS_mode_set / ERR_GET_FUNC / etc.
+# undefined-symbol nonsense the 3.4.8 ↔ OpenSSL-3 mismatch produced.
+#
+# Reticulum (>=3.4.7 required) is satisfied; tests should pass.
+#
 ################################################################################
 
-PYTHON_CRYPTOGRAPHY_VERSION = 39.0.2
+PYTHON_CRYPTOGRAPHY_VERSION = 43.0.3
 PYTHON_CRYPTOGRAPHY_SOURCE = cryptography-$(PYTHON_CRYPTOGRAPHY_VERSION).tar.gz
-PYTHON_CRYPTOGRAPHY_SITE = https://files.pythonhosted.org/packages/fa/f3/f4b8c175ea9a1de650b0085858059050b7953a93d66c97ed89b93b232996
-PYTHON_CRYPTOGRAPHY_SETUP_TYPE = setuptools-rust
+PYTHON_CRYPTOGRAPHY_SITE = https://files.pythonhosted.org/packages/0d/05/07b55d1fa21ac18c3a8c79f764e2514e6f6a9698f1be44994f5adf0d29db
+# cryptography 41+ switched build backend from setuptools-rust to maturin.
+# (see pyproject.toml: `build-backend = "maturin"`). Using SETUP_TYPE
+# `setuptools-rust` produces an empty wheel — only the pure-Python files
+# get copied and no _rust.abi3.so is generated. SETUP_TYPE=maturin is the
+# correct invocation; buildroot auto-adds host-python-maturin as a
+# build-dep and routes the build through `maturin build`.
+PYTHON_CRYPTOGRAPHY_SETUP_TYPE = maturin
 PYTHON_CRYPTOGRAPHY_LICENSE = Apache-2.0 or BSD-3-Clause
 PYTHON_CRYPTOGRAPHY_LICENSE_FILES = LICENSE LICENSE.APACHE LICENSE.BSD
 PYTHON_CRYPTOGRAPHY_CPE_ID_VENDOR = cryptography_project
 PYTHON_CRYPTOGRAPHY_CPE_ID_PRODUCT = cryptography
-PYTHON_CRYPTOGRAPHY_CARGO_MANIFEST_PATH = src/rust/Cargo.toml
-PYTHON_CRYPTOGRAPHY_DEPENDENCIES = host-python-cffi openssl
-HOST_PYTHON_CRYPTOGRAPHY_DEPENDENCIES = host-python-cffi host-openssl
+# RNSBox: explicit host-rust dep so the per-package host/lib/rustlib gets
+# the riscv64-musl target std rsynced in. Without this, the rsync from
+# host-python-maturin (which is a host pkg and only needed x86_64 rustlib
+# for itself) leaves cryptography's per-package host without target rustlib,
+# and cargo bails with "can't find crate for `core`" for every Rust file.
+PYTHON_CRYPTOGRAPHY_DEPENDENCIES = host-python-cffi openssl host-rust
+HOST_PYTHON_CRYPTOGRAPHY_DEPENDENCIES = host-python-cffi host-openssl host-rust
+
+# RNSBox: buildroot's per-package merge picks host-rust-bin's static rustc
+# binary (size 2.8 MB, version hash 6b40f50d) but host-rust's source-built
+# rustlibs (riscv64-musl libcore compiled by a DIFFERENT rustc, hash
+# 23f1d2d1...). cargo then errors with "found crate `core` compiled by an
+# incompatible version of rustc". Fix: before configure, overwrite this
+# package's per-package host/ with host-rust's per-package host/, which has
+# the consistent source-built wrapper rustc + matching rustlibs for both
+# x86_64-linux-gnu (host) and riscv64gc-unknown-linux-musl (target).
+PER_PACKAGE_DIR ?= $(BASE_DIR)/per-package
+define PYTHON_CRYPTOGRAPHY_FORCE_HOST_RUST
+	rsync -a $(PER_PACKAGE_DIR)/host-rust/host/bin/ \
+		$(PER_PACKAGE_DIR)/python-cryptography/host/bin/ 2>/dev/null || true
+	rsync -a $(PER_PACKAGE_DIR)/host-rust/host/lib/rustlib/ \
+		$(PER_PACKAGE_DIR)/python-cryptography/host/lib/rustlib/ 2>/dev/null || true
+endef
+PYTHON_CRYPTOGRAPHY_PRE_CONFIGURE_HOOKS += PYTHON_CRYPTOGRAPHY_FORCE_HOST_RUST
+
+define HOST_PYTHON_CRYPTOGRAPHY_FORCE_HOST_RUST
+	rsync -a $(PER_PACKAGE_DIR)/host-rust/host/bin/ \
+		$(PER_PACKAGE_DIR)/host-python-cryptography/host/bin/ 2>/dev/null || true
+	rsync -a $(PER_PACKAGE_DIR)/host-rust/host/lib/rustlib/ \
+		$(PER_PACKAGE_DIR)/host-python-cryptography/host/lib/rustlib/ 2>/dev/null || true
+endef
+HOST_PYTHON_CRYPTOGRAPHY_PRE_CONFIGURE_HOOKS += HOST_PYTHON_CRYPTOGRAPHY_FORCE_HOST_RUST
 
 $(eval $(python-package))
 $(eval $(host-python-package))
+
+# RNSBox: cryptography is a maturin/pyo3 package, so buildroot's python-package
+# infrastructure auto-sets <pkg>_DOWNLOAD_POST_PROCESS = cargo (pkg-python.mk).
+# That vendors the Rust crates and REPACKAGES the sdist at download time, so
+# the tarball landing in dl/ is no longer the upstream sdist and can never
+# match the upstream hash in the .hash file — a fresh/empty dl/ fails
+# .stamp_downloaded with "wrong md5 hash" (a pre-seeded dl/ hides it, because a
+# hash-matching file already present short-circuits the post-process). We do
+# NOT want download-time vendoring: keep dl/cryptography-*.tar.gz as the
+# pristine upstream sdist (hash-verified against PyPI) and let the maturin
+# build step fetch/vendor the crates at build time (into dl/br-cargo-home) —
+# exactly how every shipped RNSBox image was built. Clearing the post-process
+# after the $(eval) above overrides the macro's forced assignment. Both the
+# target and host variants share one dl/ download, so clear both.
+PYTHON_CRYPTOGRAPHY_DOWNLOAD_POST_PROCESS =
+HOST_PYTHON_CRYPTOGRAPHY_DOWNLOAD_POST_PROCESS =

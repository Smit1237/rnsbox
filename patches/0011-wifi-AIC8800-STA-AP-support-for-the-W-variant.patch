 # Makefile for the Linux Wireless network device drivers.
 #
 
-obj-$(CONFIG_AIC_WLAN_SUPPORT) += aic8800/
-obj-$(CONFIG_WLAN_VENDOR_REALTEK) += realtek/
-obj-$(CONFIG_WLAN_VENDOR_BROADCOM) += broadcom/
-obj-$(CONFIG_WLAN_VENDOR_MEDIATEK) += mediatek/
-obj-$(CONFIG_WLAN_VENDOR_ICOMMSEMI) += icommsemi/
-obj-y += rtl8733bs/
-obj-y += rtl8733bs_bt_sdio/
+# RNSBox W variant: build ONLY the AIC8800. All other vendor dirs are
+# hard-disabled (commented out), NOT CONFIG-gated. Reason: this Makefile
+# runs as a kbuild `M=` external-module pass against the kernel .config,
+# where CONFIG_WLAN_VENDOR_REALTEK happens to be =y (kernel default) and
+# CONFIG_AIC_WLAN_SUPPORT is NOT set (it lives only in the board defconfig
+# that feeds osdrv's top Makefile). So CONFIG-based gates here are
+# backwards/unreliable. The AIC8800 line is forced on with :=y-equivalent
+# literal. rtl8733bs_bt_sdio additionally can NEVER build (needs CONFIG_BT,
+# which is off) — it was the actual modpost failure (undefined hci_*).
+obj-y += aic8800/
+# obj-$(CONFIG_WLAN_VENDOR_REALTEK) += realtek/
+# obj-$(CONFIG_WLAN_VENDOR_BROADCOM) += broadcom/
+# obj-$(CONFIG_WLAN_VENDOR_MEDIATEK) += mediatek/
+# obj-$(CONFIG_WLAN_VENDOR_ICOMMSEMI) += icommsemi/
+# obj-$(CONFIG_WLAN_VENDOR_REALTEK) += rtl8733bs/
+# obj-$(CONFIG_WLAN_VENDOR_REALTEK) += rtl8733bs_bt_sdio/
 
 all:
 	$(MAKE) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) -C $(KERNEL_DIR) M=$(shell pwd) modules

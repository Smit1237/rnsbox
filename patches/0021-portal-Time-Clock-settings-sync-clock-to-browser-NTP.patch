diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/store.py b/buildroot/package/rnsbox-portal/src/rnsbox_portal/store.py
index 483b2dad8..69f2259e0 100644
--- a/buildroot/package/rnsbox-portal/src/rnsbox_portal/store.py
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/store.py
@@ -11,6 +11,7 @@ PF_FILE = f"{CONF_DIR}/portforward.conf"
 OP_FILE = f"{CONF_DIR}/openports.conf"
 WAN_FILE = f"{CONF_DIR}/wan.conf"
 CRON_FILE = f"{CONF_DIR}/cron.conf"
+NTP_FILE = "/etc/ntp.conf"          # ntp package's config; we edit its `server` lines
 
 
 def _read_lines(path):
@@ -299,3 +300,38 @@ def write_update_check(enabled):
     d = read_cron_conf()
     d["update_check"] = "yes" if enabled else "no"
     write_cron_conf(d)
+
+
+# ---- NTP servers (edit the `server` lines in /etc/ntp.conf) ----
+
+def _valid_ntp_server(s):
+    """A hostname or IPv4/IPv6 literal: letters, digits, dot, colon, hyphen."""
+    return bool(s) and len(s) <= 255 and all(
+        c.isalnum() or c in ".:-" for c in s)
+
+
+def read_ntp_servers():
+    """Configured NTP server addresses, parsed from /etc/ntp.conf."""
+    out = []
+    for ln in _read_lines(NTP_FILE):
+        parts = ln.strip().split()
+        if len(parts) >= 2 and parts[0] in ("server", "pool"):
+            out.append(parts[1])
+    return out
+
+
+def write_ntp_servers(servers):
+    """Replace the `server`/`pool` lines in /etc/ntp.conf with these servers,
+    keeping every other line (restrict, driftfile, comments) intact. Invalid
+    entries are dropped; an empty list leaves ntpd with no upstream servers.
+    Returns the list actually written."""
+    clean = [s for s in servers if _valid_ntp_server(s)]
+    kept = [ln for ln in _read_lines(NTP_FILE)
+            if ln.strip().split()[:1] not in (["server"], ["pool"])]
+    while kept and kept[0].strip() == "":      # keep the server block at the top
+        kept.pop(0)
+    new = ["server %s iburst" % s for s in clean]
+    if new and kept:
+        new.append("")
+    _write_lines(NTP_FILE, new + kept)
+    return clean
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/settings.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/settings.html
index ba2c4023f..3f6d2e20f 100644
--- a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/settings.html
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/settings.html
@@ -3,6 +3,52 @@
 {% block content %}
 <h2>Settings</h2>
 
+<section class="card">
+  <h3>Time &amp; Clock</h3>
+  <table class="kv">
+    <tr><th>System time</th><td>
+      <span class="timeval">{{ sys_time }}</span> <span class="muted">UTC</span>
+      {% if time_synced %}<span class="badge ok">synced</span>{% else %}<span class="badge warn">not synced</span>{% endif %}
+    </td></tr>
+  </table>
+
+  <h4>Sync to browser</h4>
+  <p class="muted">The board has no real-time clock, so it boots at 1970. Set the
+  clock to this device's time — the quickest way to get a correct clock on a box
+  with no internet. rnsd picks up the new time on its own.</p>
+  <p>This browser reads <strong id="browser-time">…</strong> UTC</p>
+  <form method="post" action="{{ url_for('settings_time_browser') }}"
+        onsubmit="this.epoch.value = Math.floor(Date.now()/1000)">
+    <input type="hidden" name="epoch" value="">
+    <button type="submit" class="btn-primary">Sync clock to browser</button>
+  </form>
+
+  <h4>NTP servers</h4>
+  <form method="post" action="{{ url_for('settings_ntp') }}">
+    <label>Upstream time servers — one per line; leave blank to run without NTP
+      <textarea name="servers" class="ntp-servers" rows="3" spellcheck="false">{{ ntp_servers }}</textarea>
+    </label>
+    <div class="time-actions">
+      <button type="submit" class="btn-primary">Save servers</button>
+    </div>
+  </form>
+  <form method="post" action="{{ url_for('settings_ntp_restart') }}" class="ntp-restart">
+    <button type="submit" class="btn">Restart NTP</button>
+    <span class="muted">ntpd runs with <code>-g</code>, so it steps the clock even from 1970 once it can reach a server.</span>
+  </form>
+
+  <script>
+  (function(){
+    function p(n){ return String(n).padStart(2,'0'); }
+    function fmt(d){ return d.getUTCFullYear()+'-'+p(d.getUTCMonth()+1)+'-'+p(d.getUTCDate())+' '
+                          +p(d.getUTCHours())+':'+p(d.getUTCMinutes())+':'+p(d.getUTCSeconds()); }
+    var el = document.getElementById('browser-time');
+    function tick(){ el.textContent = fmt(new Date()); }
+    tick(); setInterval(tick, 1000);
+  })();
+  </script>
+</section>
+
 <section class="card">
   <h3>Change admin password</h3>
   <form method="post" action="{{ url_for('settings_password') }}">

Subject: [PATCH 21/22] =?UTF-8?q?portal:=20Time=20&=20Clock=20settings=20?=
 =?UTF-8?q?=E2=80=94=20sync=20clock=20to=20browser=20+=20NTP=20servers?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a Time & Clock card to the Settings page for a box with no RTC:

- Sync to browser: POST /settings/time/browser sets the system clock from
  the admin's browser time (date -s @<epoch>), guarded by a 2020-2100
  plausibility check. rnsd tolerates the forward clock step without a
  restart, so setting the clock this way needs no service bounce.
- NTP servers: a minimal editor (store.read/write_ntp_servers) that edits
  only the 'server' lines in /etc/ntp.conf, preserving restrict/comment
  lines and dropping invalid entries; POST /settings/ntp saves and
  /settings/ntp/restart bounces ntpd (S49ntp) to apply.
- The card shows current system time with a synced / not-synced badge and
  a live browser clock.

All three routes are login-gated; the epoch is int-validated (incl.
OverflowError for 'inf') before use, and NTP server names are character-
validated before they reach the config file.
---
 .../rnsbox-portal/src/rnsbox_portal/app.py    | 62 ++++++++++++++++++-
 .../src/rnsbox_portal/static/style.css        |  6 ++
 .../rnsbox-portal/src/rnsbox_portal/store.py  | 36 +++++++++++
 .../src/rnsbox_portal/templates/settings.html | 46 ++++++++++++++
 4 files changed, 149 insertions(+), 1 deletion(-)

diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/app.py b/buildroot/package/rnsbox-portal/src/rnsbox_portal/app.py
index bba1f5136..4aef9e280 100644
--- a/buildroot/package/rnsbox-portal/src/rnsbox_portal/app.py
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/app.py
@@ -351,7 +351,67 @@ def create_app():
     @app.route("/settings")
     @login_required
     def settings():
-        return render_template("settings.html", wan=store.read_wan())
+        now = time.time()
+        return render_template(
+            "settings.html",
+            wan=store.read_wan(),
+            sys_time=time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(now)),
+            time_synced=(now > 1600000000),   # > 2020-09 => the clock has been set
+            ntp_servers="\n".join(store.read_ntp_servers()),
+        )
+
+    @app.route("/settings/time/browser", methods=["POST"])
+    @login_required
+    def settings_time_browser():
+        # Set the system clock from the admin's browser (no RTC on the board).
+        # The browser posts its current UTC epoch; we sanity-check it's in a
+        # plausible window before stepping the clock. rnsd tolerates the jump.
+        try:
+            # OverflowError guards int(float("inf")) — float() accepts "inf"
+            # without raising, and int(inf) then raises OverflowError.
+            epoch = int(float(request.form.get("epoch", "")))
+        except (TypeError, ValueError, OverflowError):
+            flash("Could not read the browser time.", "error")
+            return redirect(url_for("settings"))
+        if not (1577836800 <= epoch <= 4102444800):   # 2020-01-01 .. 2100-01-01
+            flash("Browser time looks implausible; clock not changed.", "error")
+            return redirect(url_for("settings"))
+        stamp = time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(epoch))
+        try:
+            # @epoch is an absolute instant (no timezone/format ambiguity);
+            # busybox 1.36 date and GNU date both accept it.
+            subprocess.run(["date", "-s", "@%d" % epoch], check=False, timeout=5)
+            flash("Clock set to %s UTC (from your browser). rnsd picks up the "
+                  "new time on its own." % stamp, "success")
+        except Exception as e:
+            flash(f"Error setting clock: {e}", "error")
+        return redirect(url_for("settings"))
+
+    @app.route("/settings/ntp", methods=["POST"])
+    @login_required
+    def settings_ntp():
+        raw = request.form.get("servers", "")
+        servers = raw.replace(",", " ").split()
+        saved = store.write_ntp_servers(servers)
+        dropped = len(servers) - len(saved)
+        msg = "Saved %d NTP server%s." % (len(saved), "" if len(saved) == 1 else "s")
+        if dropped:
+            msg += " %d invalid entr%s ignored." % (
+                dropped, "y" if dropped == 1 else "ies")
+        msg += " Restart NTP to apply."
+        flash(msg, "success")
+        return redirect(url_for("settings"))
+
+    @app.route("/settings/ntp/restart", methods=["POST"])
+    @login_required
+    def settings_ntp_restart():
+        try:
+            subprocess.run(["/etc/init.d/S49ntp", "restart"], check=False, timeout=15)
+            flash("ntpd restarted — it will step the clock once it reaches a "
+                  "server.", "success")
+        except Exception as e:
+            flash(f"Error: {e}", "error")
+        return redirect(url_for("settings"))
 
     @app.route("/settings/password", methods=["POST"])
     @login_required

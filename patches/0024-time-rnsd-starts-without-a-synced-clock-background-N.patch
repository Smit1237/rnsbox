diff --git a/build-rnsbox-kclean.sh b/build-rnsbox-kclean.sh
index ed76fd14d..42e3dfec7 100755
--- a/build-rnsbox-kclean.sh
+++ b/build-rnsbox-kclean.sh
@@ -63,6 +63,27 @@ rm -f "${BR_OVERLAY_DIR:?}"/mnt/system/ko/*.ko "$BR_OVERLAY_DIR"/mnt/system/ko/3
 
 echo "--- force-refresh local rnsbox-portal pkg ---"
 rm -rf "$BRD"/output/build/rnsbox-portal-*
+# Same package refreshes as build-rnsbox.sh: pack_rootfs below runs the full
+# buildroot make, which doesn't notice a changed .mk or a new patch.
+# dnsmasq is built with HAVE_BROKEN_RTC (package/dnsmasq/dnsmasq.mk) so its
+# leases survive S45ntpsync's background clock step: rebuild a dnsmasq whose
+# --version options lack "no-RTC".
+DNSMASQ_BIN="$BRD/output/target/usr/sbin/dnsmasq"
+if [ -f "$DNSMASQ_BIN" ] && ! grep -q 'no-RTC' "$DNSMASQ_BIN"; then
+	echo "--- dnsmasq was built without HAVE_BROKEN_RTC: rebuilding it ---"
+	rm -rf "$BRD"/output/build/dnsmasq-*
+fi
+# python-lxmf carries the RNSBox re-date patch
+# (package/python-lxmf/0001-redate-messages-stored-before-clock-set.patch).
+# Buildroot applies patches only when it extracts a package, so a tree built
+# before the patch existed keeps shipping stock LXMF: rebuild it if the
+# target LXMRouter.py lacks the patch's CLOCK_FLOOR. Nothing else has a
+# build-time dependency on python-lxmf, so removing its build dir is enough.
+LXMF_PY=$(ls "$BRD"/output/target/usr/lib/python3*/site-packages/LXMF/LXMRouter.py 2>/dev/null | head -n 1)
+if [ -n "$LXMF_PY" ] && ! grep -q CLOCK_FLOOR "$LXMF_PY"; then
+	echo "--- python-lxmf lacks the RNSBox re-date patch: rebuilding it ---"
+	rm -rf "$BRD"/output/build/python-lxmf-*
+fi
 export PATH=/usr/sbin:/sbin:$PATH
 
 echo "--- pack_rootfs + pack_burn_image ---"
diff --git a/build-rnsbox.sh b/build-rnsbox.sh
index 8912f09fa..b7cde8185 100755
--- a/build-rnsbox.sh
+++ b/build-rnsbox.sh
@@ -92,12 +92,50 @@ if grep -q '^CONFIG_IPV6=y' "$KDEFCONFIG" && [ -f "$KBUILTCFG" ] \
 	echo "         this image keeps the old kernel. Rebuild kernel + osdrv"
 	echo "         (build_all, or ./build-rnsbox-kclean.sh) for AutoInterface."
 fi
+# Same for the optional DS3231 RTC (built-in rtc-ds1307 + i2c-gpio, DTS rtc@68
+# on i2c5; the DTB comes from the kernel build too): an older kernel boots
+# fine but behaves as if no RTC were fitted.
+if grep -q '^CONFIG_RTC_DRV_DS1307=y' "$KDEFCONFIG" && [ -f "$KBUILTCFG" ] \
+   && ! grep -q '^CONFIG_RTC_DRV_DS1307=y' "$KBUILTCFG"; then
+	echo "WARNING: the built kernel lacks the DS3231 RTC driver the defconfig"
+	echo "         enables — this image acts as if no RTC were fitted. Rebuild"
+	echo "         the kernel (build_all, or ./build-rnsbox-kclean.sh)."
+fi
+# ...or has it, but built before RNSBox's rtc-ds1307.c patch (the driver keeps
+# a DS3231's oscillator-stop flag and refuses the lost time): S45ntpsync
+# trusts whatever time the kernel set the clock from, which is safe only
+# with the patch.
+KRTC_OBJ=linux_5.10/build/sg2002_licheervnano_sd/drivers/rtc/rtc-ds1307.o
+if [ -f "$KRTC_OBJ" ] && [ linux_5.10/drivers/rtc/rtc-ds1307.c -nt "$KRTC_OBJ" ]; then
+	echo "WARNING: the built kernel's rtc-ds1307 predates its oscillator-stop fix —"
+	echo "         a DS3231 that lost its time would be trusted at boot. Rebuild"
+	echo "         the kernel (build_all, or ./build-rnsbox-kclean.sh)."
+fi
 
 echo "--- source cvisetup + defconfig ---"
 source build/cvisetup.sh || { echo "FATAL: cvisetup"; exit 93; }
 defconfig sg2002_licheervnano_sd || { echo "FATAL: defconfig"; exit 94; }
 BRD="${BR_DIR:-$ROOT/buildroot}"
 rm -rf "$BRD"/output/build/rnsbox-portal-*
+# dnsmasq is built with HAVE_BROKEN_RTC (package/dnsmasq/dnsmasq.mk) so its
+# leases survive S45ntpsync's background clock step. Buildroot doesn't notice
+# a changed .mk, so rebuild a dnsmasq whose --version options lack "no-RTC".
+DNSMASQ_BIN="$BRD/output/target/usr/sbin/dnsmasq"
+if [ -f "$DNSMASQ_BIN" ] && ! grep -q 'no-RTC' "$DNSMASQ_BIN"; then
+	echo "--- dnsmasq was built without HAVE_BROKEN_RTC: rebuilding it ---"
+	rm -rf "$BRD"/output/build/dnsmasq-*
+fi
+# python-lxmf carries the RNSBox re-date patch
+# (package/python-lxmf/0001-redate-messages-stored-before-clock-set.patch).
+# Buildroot applies patches only when it extracts a package, so a tree built
+# before the patch existed keeps shipping stock LXMF: rebuild it if the
+# target LXMRouter.py lacks the patch's CLOCK_FLOOR. Nothing else has a
+# build-time dependency on python-lxmf, so removing its build dir is enough.
+LXMF_PY=$(ls "$BRD"/output/target/usr/lib/python3*/site-packages/LXMF/LXMRouter.py 2>/dev/null | head -n 1)
+if [ -n "$LXMF_PY" ] && ! grep -q CLOCK_FLOOR "$LXMF_PY"; then
+	echo "--- python-lxmf lacks the RNSBox re-date patch: rebuilding it ---"
+	rm -rf "$BRD"/output/build/python-lxmf-*
+fi
 export PATH=/usr/sbin:/sbin:$PATH
 
 # aic8800 (osdrv, out-of-tree) must be rebuilt whenever the kernel config
@@ -139,6 +177,19 @@ if [ -f "$KAUTOCONF" ] && [ -d "$KMODS" ]; then
 		&& { echo "FATAL: installed kernel modules predate the kernel config: build_kernel"; exit 97; }
 	mkdir -p "$SYSTEM_OUT_DIR/ko"
 	find "$KMODS" -name '*.ko' -exec cp -f {} "$SYSTEM_OUT_DIR/ko/" \;
+	# A driver that went =m -> =y leaves its old .ko behind here (cp never
+	# deletes), e.g. i2c-gpio + i2c-algo-bit, built in for the DS3231 RTC.
+	# Drop each top-level .ko that the same modules_install's modules.builtin
+	# now lists as built in; out-of-tree modules (3rd/) are never listed.
+	KBUILTIN=$(find "$KMODS" -name modules.builtin -print -quit)
+	if [ -n "$KBUILTIN" ]; then
+		for ko in "$SYSTEM_OUT_DIR"/ko/*.ko; do
+			[ -f "$ko" ] || continue
+			awk -F/ -v n="${ko##*/}" '$NF == n { f = 1 } END { exit !f }' "$KBUILTIN" || continue
+			echo "--- ${ko##*/} is built into the kernel now: dropping the stale module ---"
+			rm -f "$ko"
+		done
+	fi
 fi
 rm -f "${BR_OVERLAY_DIR:?}"/mnt/system/ko/*.ko "$BR_OVERLAY_DIR"/mnt/system/ko/3rd/*.ko \

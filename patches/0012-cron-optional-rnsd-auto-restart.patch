From 61452ab4945e0a6b76c1ad4d7de6566384738513 Mon Sep 17 00:00:00 2001
From: smit1237 <smit1237@gmail.com>
Date: Tue, 8 Sep 2026 22:47:49 +0300
Subject: [PATCH 12/21] cron: optional rnsd auto-restart

S84cron regenerates the root crontab from /etc/rnsbox/cron.conf at boot (the
spool is on tmpfs) and starts crond. The only task is an optional rnsd restart
every N days at 04:00 as a memory-hygiene measure; default off.
---
 .../cvitek/SG200X/overlay/etc/init.d/S84cron  | 74 +++++++++++++++++++
 .../SG200X/overlay/etc/rnsbox/cron.conf       | 12 +++
 2 files changed, 86 insertions(+)
 create mode 100755 buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
 create mode 100644 buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/cron.conf

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
new file mode 100755
index 000000000..363f9b609
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
@@ -0,0 +1,74 @@
+#!/bin/sh
+# S84cron — regenerate the root crontab from /etc/rnsbox/cron.conf and start
+# busybox crond. Runs after S82rnsd (so rnsd is up before any restart job).
+#
+# Why regenerate at boot: busybox crond reads /var/spool/cron/crontabs/root,
+# and /var/spool -> /tmp is tmpfs (wiped each boot). The persistent source of
+# truth is /etc/rnsbox/cron.conf; this script materializes it into the spool.
+#
+# Currently the only scheduled task is the optional rnsd auto-restart
+# (memory hygiene): rnsd_restart_days=N restarts rnsd every N days at 04:00.
+# N=0 (default) means no crontab entry — crond still runs but has nothing to do.
+
+CONF=/etc/rnsbox/cron.conf
+CRONDIR=/var/spool/cron/crontabs
+CRONTAB="$CRONDIR/root"
+LOG=/var/log/cron.log
+
+cfg() {
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+gen_crontab() {
+	mkdir -p "$CRONDIR"
+	days=$(cfg rnsd_restart_days)
+	case "$days" in ''|*[!0-9]*) days=0 ;; esac
+	{
+		echo "# Auto-generated by S84cron from $CONF — do not hand-edit."
+		echo "# (edit /etc/rnsbox/cron.conf or use the portal Reticulum tab)"
+		if [ "$days" -ge 1 ] 2>/dev/null && [ "$days" -le 7 ]; then
+			# min hour day-of-month month day-of-week  command
+			# every N days at 04:00
+			echo "0 4 */$days * * /etc/init.d/S82rnsd restart >> $LOG 2>&1"
+		fi
+	} > "$CRONTAB"
+	chmod 600 "$CRONTAB"
+	[ "$days" -ge 1 ] 2>/dev/null && echo "S84cron: rnsd auto-restart every $days day(s) at 04:00" \
+	                              || echo "S84cron: rnsd auto-restart disabled"
+}
+
+start() {
+	gen_crontab
+	# -b = background; -c = crontab dir (parent of crontabs/). Start only if
+	# not already running.
+	if ! pidof crond >/dev/null 2>&1; then
+		crond -b -c "$CRONDIR" 2>>"$LOG"
+	fi
+}
+
+stop() {
+	killall crond 2>/dev/null
+}
+
+# `reload` = regenerate the crontab and signal crond to re-read, without a full
+# restart. The portal calls this after changing the schedule.
+reload() {
+	gen_crontab
+	if pidof crond >/dev/null 2>&1; then
+		# busybox crond re-reads when the crontab mtime changes; gen_crontab
+		# rewrote it, so a HUP or just leaving it is enough. HUP to be prompt.
+		killall -HUP crond 2>/dev/null || true
+	else
+		crond -b -c "$CRONDIR" 2>>"$LOG"
+	fi
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; sleep 1; start ;;
+	reload)  reload ;;
+	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
+esac
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/cron.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/cron.conf
new file mode 100644
index 000000000..d920c1493
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/cron.conf
@@ -0,0 +1,12 @@
+# RNSBox scheduled tasks — managed by the rnsbox-portal Reticulum tab.
+#
+# rnsd_restart_days:
+#   0   disabled (default) — no automatic restart; the operator decides.
+#   N   restart rnsd every N days (N = 1..7) at 04:00, via cron, as a memory
+#       hygiene measure. rnsd's RAM use is announce-cache growth, not a leak,
+#       but a periodic restart bounds the long-run envelope on the 245 MB box.
+#
+# Applied by /etc/init.d/S84cron at boot (it regenerates the root crontab and
+# starts crond) and live by the portal when you change it in the UI.
+
+rnsd_restart_days=0

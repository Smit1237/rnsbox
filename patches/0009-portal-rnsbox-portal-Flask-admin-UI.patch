diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/network.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/network.html
new file mode 100644
index 000000000..50c042cc5
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/network.html
@@ -0,0 +1,169 @@
+{% extends "base.html" %}
+{% block title %}Network{% endblock %}
+{% block content %}
+<h2>Network</h2>
+<p class="muted">WAN: <strong>{{ wan }}</strong> &middot; LAN: <strong>usb0</strong> &middot; default gateway: <strong>{{ net.default_gateway or '(none)' }}</strong></p>
+
+<section class="card">
+  <h3>WAN uplink</h3>
+  <p class="muted">Which interface reaches the internet, and how it gets its
+  address. NAT masquerade + the default route follow this choice.
+  <strong>wlan0</strong> requires the WiFi client to be connected (WiFi tab →
+  mode <em>sta</em> or <em>sta+ap</em>) and is always DHCP-addressed by the WiFi
+  stack — the static fields below apply to <strong>eth0</strong> only.</p>
+  <form method="post" action="{{ url_for('wan_set') }}">
+    <label>Interface
+      <select name="wan">
+        <option value="eth0"  {{ 'selected' if wan == 'eth0'  else '' }}>eth0 — wired Ethernet</option>
+        <option value="wlan0" {{ 'selected' if wan == 'wlan0' else '' }}>wlan0 — WiFi client</option>
+      </select>
+    </label>
+    <label>Addressing
+      <select name="wan_mode" id="wan_mode" onchange="wanModeToggle()">
+        <option value="dhcp"   {{ 'selected' if wan_cfg.mode != 'static' else '' }}>DHCP (automatic)</option>
+        <option value="static" {{ 'selected' if wan_cfg.mode == 'static' else '' }}>Static IP</option>
+      </select>
+    </label>
+    <div id="wan_static" style="{{ '' if wan_cfg.mode == 'static' else 'display:none' }}">
+      <label>IP address
+        <input type="text" name="wan_address" value="{{ wan_cfg.address }}" placeholder="192.168.1.50">
+      </label>
+      <label>Netmask (CIDR prefix, 1–32)
+        <input type="number" name="wan_prefix" min="1" max="32" value="{{ wan_cfg.prefix or 24 }}" placeholder="24">
+      </label>
+      <label>Gateway
+        <input type="text" name="wan_gateway" value="{{ wan_cfg.gateway }}" placeholder="192.168.1.1">
+      </label>
+      <label>DNS servers (space- or comma-separated)
+        <input type="text" name="wan_dns" value="{{ wan_cfg.dns }}" placeholder="1.1.1.1 8.8.8.8">
+      </label>
+    </div>
+    <button type="submit" class="btn-primary">Set WAN</button>
+  </form>
+  <script>
+    function wanModeToggle(){
+      var m = document.getElementById('wan_mode').value;
+      document.getElementById('wan_static').style.display = (m === 'static') ? '' : 'none';
+    }
+  </script>
+</section>
+
+<section class="card">
+  <h3>Port forwards (WAN → LAN)</h3>
+  <p class="muted">Inbound TCP/UDP traffic arriving on the WAN port is DNAT'd to the LAN host:port. The matching FORWARD rule is added automatically.</p>
+  <table class="data">
+    <thead>
+      <tr><th>Proto</th><th>WAN port</th><th>LAN target</th><th>Comment</th><th></th></tr>
+    </thead>
+    <tbody>
+      {% for fw in forwards %}
+      <tr>
+        <td><span class="badge {{ fw.proto }}">{{ fw.proto|upper }}</span></td>
+        <td>{{ fw.wan_port }}</td>
+        <td>{{ fw.lan_ip }}:{{ fw.lan_port }}</td>
+        <td>{{ fw.comment }}</td>
+        <td>
+          <form method="post" action="{{ url_for('pf_del') }}" class="inline">
+            <input type="hidden" name="idx" value="{{ loop.index0 }}">
+            <button type="submit" class="btn-danger">Remove</button>
+          </form>
+        </td>
+      </tr>
+      {% else %}
+      <tr><td colspan="5" class="muted">No port forwards configured.</td></tr>
+      {% endfor %}
+    </tbody>
+  </table>
+
+  <form method="post" action="{{ url_for('pf_add') }}" class="row-form">
+    <select name="proto" required>
+      <option value="tcp">TCP</option>
+      <option value="udp">UDP</option>
+    </select>
+    <input name="wan_port" type="number" min="1" max="65535" placeholder="WAN port" required>
+    <input name="lan_ip" type="text" placeholder="LAN IP (e.g. 10.42.0.10)" required>
+    <input name="lan_port" type="number" min="1" max="65535" placeholder="LAN port" required>
+    <input name="comment" type="text" placeholder="comment (optional)">
+    <button type="submit" class="btn-primary">Add</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Open ports (services on this router exposed on WAN)</h3>
+  <p class="muted">Allows inbound connections on the WAN to services bound on this device. <strong>SSH (22)</strong> and the <strong>web UI (80)</strong> are open by default &mdash; remove them to close WAN access (the LAN/<code>usb0</code> side always stays open). Add rnsd's TCPServerInterface port (4242) here for external Reticulum peers.</p>
+  <table class="data">
+    <thead>
+      <tr><th>Proto</th><th>Port</th><th>Comment</th><th></th></tr>
+    </thead>
+    <tbody>
+      {% for op in openports %}
+      <tr>
+        <td><span class="badge {{ op.proto }}">{{ op.proto|upper }}</span></td>
+        <td>{{ op.port }}</td>
+        <td>{{ op.comment }}</td>
+        <td>
+          <form method="post" action="{{ url_for('op_del') }}" class="inline">
+            <input type="hidden" name="idx" value="{{ loop.index0 }}">
+            <button type="submit" class="btn-danger">Remove</button>
+          </form>
+        </td>
+      </tr>
+      {% else %}
+      <tr><td colspan="4" class="muted">No open ports &mdash; WAN access is closed (the LAN/usb0 side stays open).</td></tr>
+      {% endfor %}
+    </tbody>
+  </table>
+
+  <form method="post" action="{{ url_for('op_add') }}" class="row-form">
+    <select name="proto" required>
+      <option value="tcp">TCP</option>
+      <option value="udp">UDP</option>
+    </select>
+    <input name="port" type="number" min="1" max="65535" placeholder="Port" required>
+    <input name="comment" type="text" placeholder="comment (optional)">
+    <button type="submit" class="btn-primary">Add</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>LAN clients (DHCP leases)</h3>
+  <table class="data">
+    <thead>
+      <tr><th>IP</th><th>MAC</th><th>Name</th><th>Expires (epoch)</th></tr>
+    </thead>
+    <tbody>
+      {% for l in leases %}
+      <tr>
+        <td>{{ l.ip }}</td>
+        <td><code>{{ l.mac }}</code></td>
+        <td>{{ l.name }}</td>
+        <td>{{ l.expires }}</td>
+      </tr>
+      {% else %}
+      <tr><td colspan="4" class="muted">No active leases.</td></tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</section>
+
+<section class="card">
+  <h3>All interfaces</h3>
+  <table class="data">
+    <thead>
+      <tr><th>Iface</th><th>State</th><th>Address</th><th>MAC</th><th>MTU</th><th>RX / TX</th></tr>
+    </thead>
+    <tbody>
+      {% for name, i in net.ifaces.items() %}
+      <tr>
+        <td><strong>{{ name }}</strong></td>
+        <td>{% if i.state == 'up' %}<span class="badge ok">UP</span>{% else %}<span class="badge warn">{{ i.state or '?' }}</span>{% endif %}</td>
+        <td>{{ i.addrs|join(', ') }}</td>
+        <td><code>{{ i.mac }}</code></td>
+        <td>{{ i.mtu }}</td>
+        <td>{{ i.rx }} / {{ i.tx }}</td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</section>
+{% endblock %}
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/reticulum.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/reticulum.html
new file mode 100644
index 000000000..5e32f8a16
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/reticulum.html
@@ -0,0 +1,63 @@
+{% extends "base.html" %}
+{% block title %}Reticulum{% endblock %}
+{% block content %}
+<h2>Reticulum</h2>
+
+<section class="card">
+  <h3>rnsd status</h3>
+  <table class="kv">
+    <tr><th>State</th><td id="rnsd-state">
+      {% if rnsd.running %}<span class="badge ok">RUNNING</span> (pid {{ rnsd.pid }}){% else %}<span class="badge err">STOPPED</span>{% endif %}
+    </td></tr>
+  </table>
+  <form method="post" action="{{ url_for('reticulum_restart') }}" class="inline">
+    <button type="submit" class="btn-primary">Restart rnsd</button>
+  </form>
+  <button type="button" class="btn" onclick="loadRnstatus()">Refresh</button>
+
+  <form method="post" action="{{ url_for('reticulum_autorestart') }}" class="row-form" style="margin-top:10px">
+    <label for="rnsd_days" style="margin:0">Auto-restart rnsd</label>
+    <select id="rnsd_days" name="days">
+      <option value="0" {{ 'selected' if restart_days == 0 else '' }}>None (default)</option>
+      {% for d in range(1, 8) %}
+      <option value="{{ d }}" {{ 'selected' if restart_days == d else '' }}>every {{ d }} day{{ 's' if d > 1 else '' }}</option>
+      {% endfor %}
+    </select>
+    <button type="submit" class="btn">Save schedule</button>
+    <span class="muted">restarts at 04:00 — bounds rnsd's announce-cache RAM growth</span>
+  </form>
+
+  <h4>rnstatus -a</h4>
+  <pre class="log" id="rnstatus"><span class="muted">loading… (querying the rnsd instance, can take a few seconds)</span></pre>
+</section>
+
+<section class="card">
+  <h3>/etc/reticulum/config</h3>
+  <p class="muted">Hand-edit the rnsd configuration. Comments and interface declarations are passed verbatim to Reticulum. Click <em>Save</em> then <em>Restart rnsd</em> to apply.</p>
+  <form method="post" action="{{ url_for('reticulum_config_save') }}">
+    <textarea name="config" rows="24" spellcheck="false">{{ cfg }}</textarea>
+    <button type="submit" class="btn-primary">Save</button>
+  </form>
+</section>
+
+<script>
+function loadRnstatus(){
+  var pre = document.getElementById('rnstatus');
+  var st  = document.getElementById('rnsd-state');
+  pre.innerHTML = '<span class="muted">loading… (querying the rnsd instance, can take a few seconds)</span>';
+  fetch('{{ url_for("reticulum_status") }}').then(function(r){ return r.json(); }).then(function(d){
+    // refresh the state badge too (it's free and may have changed since load)
+    if (d.running) {
+      st.innerHTML = '<span class="badge ok">RUNNING</span> (pid ' + d.pid + ')' +
+                     (d.rss_mb ? ' · ' + d.rss_mb + ' MB RSS' : '');
+    } else {
+      st.innerHTML = '<span class="badge err">STOPPED</span>';
+    }
+    pre.textContent = d.raw ? d.raw : (d.running ? '(rnstatus returned nothing)' : 'rnsd is not running.');
+  }).catch(function(){
+    pre.textContent = 'failed to fetch rnstatus (request timed out or rnsd unreachable).';
+  });
+}
+document.addEventListener('DOMContentLoaded', loadRnstatus);
+</script>
+{% endblock %}

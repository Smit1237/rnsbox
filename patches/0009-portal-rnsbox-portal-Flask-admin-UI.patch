+{% extends "base.html" %}
+{% block title %}Settings{% endblock %}
+{% block content %}
+<h2>Settings</h2>
+
+<section class="card">
+  <h3>Change admin password</h3>
+  <form method="post" action="{{ url_for('settings_password') }}">
+    <label>Current password
+      <input type="password" name="old" autocomplete="current-password" required>
+    </label>
+    <label>New password (≥6 chars)
+      <input type="password" name="new" autocomplete="new-password" required minlength="6">
+    </label>
+    <label>Confirm new password
+      <input type="password" name="confirm" autocomplete="new-password" required minlength="6">
+    </label>
+    <button type="submit" class="btn-primary">Change password</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Hostname</h3>
+  <form method="post" action="{{ url_for('settings_hostname') }}">
+    <label>New hostname
+      <input type="text" name="hostname" value="{{ hostname }}" maxlength="63" required>
+    </label>
+    <button type="submit" class="btn-primary">Apply</button>
+    <p class="muted">Alphanumerics, dashes, underscores. Effective immediately for new connections; reboot for SSH banners + log file naming.</p>
+  </form>
+</section>
+
+<section class="card">
+  <h3>WAN interface</h3>
+  <p>Currently: <strong>{{ wan }}</strong></p>
+  <p class="muted">Switch the WAN uplink (eth0 wired ↔ wlan0 WiFi) from the
+  <a href="{{ url_for('network') }}">Network</a> tab. On the W variant, wlan0
+  WAN also needs the WiFi client connected (<a href="{{ url_for('wifi_page') }}">WiFi</a> tab).</p>
+</section>
+{% endblock %}
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/wifi.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/wifi.html
new file mode 100644
index 000000000..bb93ea14e
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/wifi.html
@@ -0,0 +1,142 @@
+{% extends "base.html" %}
+{% block title %}WiFi{% endblock %}
+{% block content %}
+<h2>WiFi</h2>
+
+{% if not present %}
+<section class="card">
+  <p class="muted">No WiFi radio detected. This is the non-W board, or the
+  AIC8800 driver hasn't loaded. Check <code>/var/log/wifi.log</code> and
+  <code>dmesg | grep aic</code>.</p>
+</section>
+{% else %}
+
+<section class="card">
+  <h3>Status</h3>
+  <table class="kv">
+    <tr><th>Mode</th><td><span class="badge">{{ status.mode }}</span></td></tr>
+    <tr><th>Client (STA)</th><td>
+      {% if status.sta.connected %}
+        <span class="badge ok">CONNECTED</span> {{ status.sta.ssid }}
+        ({{ status.sta.signal }} dBm){% if status.sta.width %}, {{ status.sta.width }} MHz{% endif %} — {{ status.sta.ip or 'no IP' }}
+      {% else %}<span class="badge warn">not connected</span>{% endif %}
+    </td></tr>
+    <tr><th>Hotspot (AP)</th><td>
+      {% if status.ap.active %}
+        <span class="badge ok">UP</span> on {{ status.ap.iface }},
+        {{ status.ap.clients }} client(s){% if status.ap.width %}, {{ status.ap.width }} MHz{% endif %}, {{ status.ap.ip }}
+      {% else %}<span class="badge warn">off</span>{% endif %}
+    </td></tr>
+    <tr><th>TX power</th><td>
+      configured <span class="badge">{{ status.tx_power }}</span>{% if status.sta.connected and status.sta.txpower %} · STA {{ status.sta.txpower }} dBm{% endif %}{% if status.ap.active and status.ap.txpower %} · AP {{ status.ap.txpower }} dBm{% endif %}
+    </td></tr>
+  </table>
+  <form method="post" action="{{ url_for('wifi_mode') }}" class="row-form">
+    <select name="mode">
+      {% for m in ['off','sta','ap','sta+ap'] %}
+      <option value="{{ m }}" {{ 'selected' if cfg.mode==m else '' }}>{{ m }}</option>
+      {% endfor %}
+    </select>
+    <button type="submit" class="btn">Set mode</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Join a network (client)</h3>
+  <button type="button" class="btn" onclick="doScan()">Scan</button>
+  <span id="scanmsg" class="muted"></span>
+  <table class="data" id="scantbl" style="margin-top:8px; display:none">
+    <thead><tr><th>SSID</th><th>Signal</th><th>Ch</th><th>Security</th><th></th></tr></thead>
+    <tbody></tbody>
+  </table>
+  <form method="post" action="{{ url_for('wifi_connect') }}" class="row-form" style="margin-top:10px">
+    <input name="ssid" id="ssid" type="text" placeholder="SSID" value="{{ cfg.sta_ssid }}" required>
+    <input name="psk" id="sta_psk" type="password" placeholder="password (blank = open)">
+    <button type="button" class="btn" onclick="togglePw('sta_psk', this)">Show</button>
+    <button type="submit" class="btn-primary">Connect</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Hotspot (access point)</h3>
+  <p class="muted">Runs concurrently with the client connection (AIC8800
+  single radio, time-shared). AP clients are NAT'd to the WAN and get DHCP
+  from the AP subnet in <code>/etc/rnsbox/wifi.conf</code>.</p>
+  <form method="post" action="{{ url_for('wifi_ap') }}">
+    <label><input type="checkbox" name="ap_enable" {{ 'checked' if cfg.mode in ['ap','sta+ap'] else '' }}> Enable hotspot</label>
+    <label>SSID <input type="text" name="ap_ssid" value="{{ cfg.ap_ssid }}"></label>
+    <label>Password (≥8 chars)
+      <input type="password" id="ap_psk" name="ap_psk" value="{{ cfg.ap_psk }}">
+      <button type="button" class="btn" onclick="togglePw('ap_psk', this)">Show</button>
+    </label>
+    {% set concurrent = cfg.mode == 'sta+ap' %}
+    <label>Channel{% if concurrent %} <span class="muted">(locked — follows client link)</span>{% endif %}
+      <select name="ap_channel" {{ 'disabled' if concurrent else '' }}>
+        <option value="auto" {{ 'selected' if cfg.ap_channel == 'auto' else '' }}>auto (ACS)</option>
+        {% for c in range(1, 14) %}
+        <option value="{{ c }}" {{ 'selected' if cfg.ap_channel == c|string else '' }}>{{ c }}</option>
+        {% endfor %}
+      </select>
+    </label>
+    <label>Width{% if concurrent %} <span class="muted">(locked — follows client link)</span>{% endif %}
+      <select name="ap_htmode" {{ 'disabled' if concurrent else '' }}>
+        <option value="ht20" {{ 'selected' if cfg.ap_htmode != 'ht40' else '' }}>20 MHz (HT20)</option>
+        <option value="ht40" {{ 'selected' if cfg.ap_htmode == 'ht40' else '' }}>40 MHz (HT40)</option>
+      </select>
+    </label>
+    <button type="submit" class="btn-primary">Apply hotspot</button>
+  </form>
+  <p class="muted" style="margin-top:8px">In concurrent <em>sta+ap</em> mode the
+  hotspot inherits the client's channel <em>and</em> width (single radio), so it
+  runs at 40 MHz whenever the client link is 40 MHz. <em>auto</em> channel and a
+  manually chosen 40 MHz apply only in AP-only mode; if the radio can't honor
+  them the hotspot falls back to a 20 MHz channel.</p>
+</section>
+
+<section class="card">
+  <h3>TX power</h3>
+  <p class="muted">Radio-wide — applies to both client and hotspot (single
+  radio). <strong>auto</strong> = chip maximum, independent of the regulatory
+  database. A number caps power; firmware still applies per-rate EVM backoff
+  below it. The AIC8800D80 OFDM ceiling is ~18&nbsp;dBm (datasheet: 23&nbsp;dBm
+  11b-CCK, 18&nbsp;dBm MCS7), so values above ~18 only affect legacy 11b, not
+  data-rate throughput. Set lower to cut heat/range.</p>
+  <form method="post" action="{{ url_for('wifi_txpower') }}" class="row-form">
+    <select name="tx_power">
+      <option value="auto" {{ 'selected' if cfg.tx_power in ['auto','max',''] else '' }}>auto (chip max ≈ 18 dBm)</option>
+      {% for d in range(18, 0, -1) %}
+      <option value="{{ d }}" {{ 'selected' if cfg.tx_power == d|string else '' }}>{{ d }} dBm{{ ' (max)' if d == 18 else '' }}</option>
+      {% endfor %}
+    </select>
+    <button type="submit" class="btn-primary">Set TX power</button>
+  </form>
+</section>
+
+<script>
+// Show/hide a password field. Flips the input type and the button label.
+function togglePw(id, btn){
+  var el = document.getElementById(id);
+  if (!el) return;
+  if (el.type === 'password'){ el.type = 'text';  btn.textContent = 'Hide'; }
+  else                       { el.type = 'password'; btn.textContent = 'Show'; }
+}
+function doScan(){
+  var msg=document.getElementById('scanmsg'); msg.textContent='scanning…';
+  fetch('{{ url_for("wifi_scan") }}').then(r=>r.json()).then(function(nets){
+    var tbl=document.getElementById('scantbl'), tb=tbl.querySelector('tbody');
+    tb.innerHTML='';
+    if(!nets.length){ msg.textContent='no networks found'; return; }
+    msg.textContent=nets.length+' found'; tbl.style.display='';
+    nets.forEach(function(n){
+      var tr=document.createElement('tr');
+      tr.innerHTML='<td>'+(n.ssid||'(hidden)')+'</td><td>'+n.signal+' dBm</td><td>'+
+        (n.channel||'')+'</td><td>'+n.security+'</td>'+
+        '<td><button type="button" class="btn">Use</button></td>';
+      tr.querySelector('button').onclick=function(){ document.getElementById('ssid').value=n.ssid; };
+      tb.appendChild(tr);
+    });
+  }).catch(function(){ msg.textContent='scan failed'; });
+}
+</script>
+{% endif %}
+{% endblock %}
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/wifi.py b/buildroot/package/rnsbox-portal/src/rnsbox_portal/wifi.py
new file mode 100644
index 000000000..ecf8ebbcd
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/wifi.py
@@ -0,0 +1,167 @@
+"""WiFi management for the AIC8800 (LicheeRV Nano-e W variant).
+
+Reads/writes /etc/rnsbox/wifi.conf (flat key=value, shared with S35wifi),
+runs `iw` for scanning, and shells /etc/init.d/S35wifi to apply changes.
+Degrades gracefully on the non-W board (no wlan device): present() is
+False and the UI shows a "no radio" state.
+"""
+import os
+import re
+import subprocess
+
+CONF = "/etc/rnsbox/wifi.conf"
+INIT = "/etc/init.d/S35wifi"
+STA_IF = "wlan0"
+
+_KEYS = (
+    "mode", "sta_ssid", "sta_psk", "sta_hidden", "sta_country",
+    "ap_ssid", "ap_psk", "ap_channel", "ap_htmode", "ap_hidden",
+    "ap_ip", "ap_dhcp_start", "ap_dhcp_end",
+    "tx_power",
+)
+
+
+def present():
+    try:
+        return any(d.startswith("wlan") for d in os.listdir("/sys/class/net"))
+    except FileNotFoundError:
+        return False
+
+
+def read_conf():
+    cfg = {k: "" for k in _KEYS}
+    cfg.update(mode="off", ap_ssid="RNSBox-AP", ap_channel="6",
+               ap_htmode="ht20", ap_ip="192.168.42.1", tx_power="auto")
+    try:
+        with open(CONF) as f:
+            for ln in f:
+                s = ln.strip()
+                if not s or s.startswith("#") or "=" not in s:
+                    continue
+                k, _, v = s.partition("=")
+                k = k.strip()
+                v = v.split("#", 1)[0].strip().strip('"').strip("'")
+                if k in cfg:
+                    cfg[k] = v
+    except FileNotFoundError:
+        pass
+    return cfg
+
+
+def write_conf(updates):
+    cfg = read_conf()
+    cfg.update({k: v for k, v in updates.items() if k in _KEYS})
+    os.makedirs(os.path.dirname(CONF), exist_ok=True)
+    tmp = CONF + ".tmp"
+    with open(tmp, "w") as f:
+        f.write("# RNSBox WiFi config — managed by rnsbox-portal.\n")
+        f.write("# mode: off | sta | ap | sta+ap\n\n")
+        f.write(f"mode={cfg['mode']}\n\n")
+        f.write("# --- STA (client) ---\n")
+        for k in ("sta_ssid", "sta_psk", "sta_hidden", "sta_country"):
+            f.write(f"{k}={cfg[k]}\n")
+        f.write("\n# --- AP (hotspot) ---\n")
+        for k in ("ap_ssid", "ap_psk", "ap_channel", "ap_htmode", "ap_hidden",
+                  "ap_ip", "ap_dhcp_start", "ap_dhcp_end"):
+            f.write(f"{k}={cfg[k]}\n")
+        f.write("\n# --- TX power (radio-wide): auto = chip max, or 1..20 dBm ---\n")
+        f.write(f"tx_power={cfg['tx_power']}\n")
+    os.rename(tmp, CONF)
+
+
+def _run(cmd, timeout=20):
+    try:
+        return subprocess.run(cmd, capture_output=True, text=True,
+                              timeout=timeout).stdout
+    except Exception:
+        return ""
+
+
+def scan():
+    """List of {ssid, signal, channel, security} from `iw scan`."""
+    if not present():
+        return []
+    subprocess.run(["ip", "link", "set", STA_IF, "up"], check=False)
+    out = _run(["iw", "dev", STA_IF, "scan"], timeout=15)
+    nets = {}
+    for block in re.split(r"\nBSS ", "\n" + out):
+        m = re.search(r"\n\s*SSID: (.*)", block)
+        if not m:
+            continue
+        ssid = m.group(1).strip()
+        if not ssid:
+            continue
+        sig = re.search(r"signal: (-?\d+\.?\d*)", block)
+        ch = re.search(r"channel (\d+)", block)
+        secured = ("RSN:" in block) or ("WPA:" in block)
+        entry = {
+            "ssid": ssid,
+            "signal": sig.group(1) if sig else "",
+            "channel": ch.group(1) if ch else "",
+            "security": "secured" if secured else "open",
+        }
+        prev = nets.get(ssid)
+        if not prev or (entry["signal"] and prev["signal"] and
+                        float(entry["signal"]) > float(prev["signal"])):
+            nets[ssid] = entry
+    return sorted(nets.values(),
+                  key=lambda e: float(e["signal"]) if e["signal"] else -999,
+                  reverse=True)
+
+
+def _ip_of(dev):
+    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)",
+                  _run(["ip", "-4", "addr", "show", "dev", dev], timeout=5))
+    return m.group(1) if m else ""
+
+
+def _txpower_of(info):
+    """Parse 'txpower 18.00 dBm' from `iw dev <if> info` output."""
+    m = re.search(r"txpower (-?\d+\.?\d*) dBm", info)
+    return m.group(1) if m else ""
+
+
+def _width_of(info):
+    """Parse 'width: 40 MHz' from `iw dev <if> info` output."""
+    m = re.search(r"width: (\d+) MHz", info)
+    return m.group(1) if m else ""
+
+
+def status():
+    cfg = read_conf()
+    info = {"present": present(), "mode": cfg["mode"],
+            "tx_power": cfg["tx_power"] or "auto",
+            "sta": {"connected": False}, "ap": {"active": False}}
+    if not info["present"]:
+        return info
+    link = _run(["iw", "dev", STA_IF, "link"], timeout=5)
+    if "Connected to" in link:
+        ssid = re.search(r"SSID: (.*)", link)
+        sig = re.search(r"signal: (-?\d+)", link)
+        sta_info = _run(["iw", "dev", STA_IF, "info"], timeout=5)
+        info["sta"] = {"connected": True,
+                       "ssid": ssid.group(1).strip() if ssid else "",
+                       "signal": sig.group(1) if sig else "",
+                       "ip": _ip_of(STA_IF),
+                       "width": _width_of(sta_info),
+                       "txpower": _txpower_of(sta_info)}
+    ap_if = None
+    try:
+        with open("/run/wifi-ap-iface") as f:
+            ap_if = f.read().strip()
+    except FileNotFoundError:
+        pass
+    if ap_if and os.path.exists(f"/sys/class/net/{ap_if}"):
+        clients = _run(["iw", "dev", ap_if, "station", "dump"], timeout=5)
+        ap_info = _run(["iw", "dev", ap_if, "info"], timeout=5)
+        info["ap"] = {"active": True, "iface": ap_if,
+                      "clients": clients.count("Station "), "ip": _ip_of(ap_if),
+                      "width": _width_of(ap_info),
+                      "txpower": _txpower_of(ap_info)}
+    return info
+
+
+def apply():
+    """Restart S35wifi, then re-run routing so the AP iface joins NAT/DHCP."""
+    subprocess.run([INIT, "restart"], check=False, timeout=30)
+    subprocess.run(["/etc/init.d/S60routing", "restart"], check=False, timeout=15)

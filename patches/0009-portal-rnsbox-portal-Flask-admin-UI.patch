diff --git a/buildroot/package/rnsbox-portal/Config.in b/buildroot/package/rnsbox-portal/Config.in
new file mode 100644
index 000000000..b8fbefbdf
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/Config.in
@@ -0,0 +1,19 @@
+config BR2_PACKAGE_RNSBOX_PORTAL
+	bool "rnsbox-portal"
+	select BR2_PACKAGE_PYTHON3
+	select BR2_PACKAGE_PYTHON_FLASK
+	help
+	  OpenWrt-style admin web UI for the RNSBox router build.
+
+	  Features:
+	    - Dashboard: system + Reticulum status at a glance
+	    - Network: WAN/LAN status, dnsmasq leases, port forwards
+	      (WAN -> LAN DNAT), WAN-side open ports (input ACCEPT)
+	    - Reticulum: live rnsd status, raw config editor, restart
+	    - Settings: admin password + hostname
+
+	  Stores port-forward / open-port / auth state under
+	  /etc/rnsbox/ and regenerates /etc/nftables.conf via
+	  rnsbox_portal.nftgen (called by /etc/init.d/S60routing).
+
+	  Pure-Python; no Go/Node toolchain needed. Source is local.
diff --git a/buildroot/package/rnsbox-portal/rnsbox-portal.mk b/buildroot/package/rnsbox-portal/rnsbox-portal.mk
new file mode 100644
index 000000000..93c9afed8
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/rnsbox-portal.mk
@@ -0,0 +1,34 @@
+################################################################################
+#
+# rnsbox-portal — Flask admin UI for the RNSBox router build
+#
+# Pure-Python package, installed manually under /usr/lib/rnsbox-portal/ with
+# a launcher script at /usr/sbin/rnsbox-portal that sets PYTHONPATH and
+# execs `python3 -m rnsbox_portal`. Avoids setuptools because the package
+# isn't pip-published — local source only.
+#
+# nftables generation also lives in this package (rnsbox_portal.nftgen) so
+# the same single source of truth feeds both the UI and the init scripts.
+#
+################################################################################
+
+RNSBOX_PORTAL_VERSION = 0.1.0
+RNSBOX_PORTAL_SITE = $(TOPDIR)/package/rnsbox-portal/src
+RNSBOX_PORTAL_SITE_METHOD = local
+RNSBOX_PORTAL_LICENSE = MIT
+RNSBOX_PORTAL_LICENSE_FILES = LICENSE
+
+define RNSBOX_PORTAL_INSTALL_TARGET_CMDS
+	mkdir -p $(TARGET_DIR)/usr/lib/rnsbox-portal/rnsbox_portal/templates
+	mkdir -p $(TARGET_DIR)/usr/lib/rnsbox-portal/rnsbox_portal/static
+	$(INSTALL) -m 0644 $(@D)/rnsbox_portal/*.py \
+		$(TARGET_DIR)/usr/lib/rnsbox-portal/rnsbox_portal/
+	$(INSTALL) -m 0644 $(@D)/rnsbox_portal/templates/*.html \
+		$(TARGET_DIR)/usr/lib/rnsbox-portal/rnsbox_portal/templates/
+	$(INSTALL) -m 0644 $(@D)/rnsbox_portal/static/* \
+		$(TARGET_DIR)/usr/lib/rnsbox-portal/rnsbox_portal/static/
+	$(INSTALL) -D -m 0755 $(@D)/bin/rnsbox-portal \
+		$(TARGET_DIR)/usr/sbin/rnsbox-portal
+endef
+
+$(eval $(generic-package))

+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{% block title %}RNSBox{% endblock %} — {{ hostname }}</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
+</head>
+<body class="{% if not session.get('user') %}login-screen{% endif %}">
+{% if session.get('user') %}
+<header class="topbar">
+  <div class="brand">
+    <span class="logo">⬢</span>
+    <span class="brand-name">RNSBox</span>
+    <span class="brand-host">{{ hostname }}</span>
+  </div>
+  <nav class="topnav">
+    <span class="user">{{ session.user }}</span>
+    <a class="logout" href="{{ url_for('logout') }}">Logout</a>
+  </nav>
+</header>
+<div class="page">
+  <aside class="sidebar">
+    <a href="{{ url_for('dashboard') }}" class="{{ 'active' if request.endpoint == 'dashboard' else '' }}">Dashboard</a>
+    <a href="{{ url_for('network') }}" class="{{ 'active' if request.endpoint and request.endpoint.startswith('network') or request.endpoint in ['pf_add','pf_del','op_add','op_del'] else '' }}">Network</a>
+    <a href="{{ url_for('wifi_page') }}" class="{{ 'active' if request.endpoint and request.endpoint.startswith('wifi') else '' }}">WiFi</a>
+    <a href="{{ url_for('reticulum') }}" class="{{ 'active' if request.endpoint and request.endpoint.startswith('reticulum') else '' }}">Reticulum</a>
+    <a href="{{ url_for('settings') }}" class="{{ 'active' if request.endpoint and request.endpoint.startswith('settings') else '' }}">Settings</a>
+  </aside>
+  <main class="content">
+    {% with msgs = get_flashed_messages(with_categories=true) %}
+      {% for cat, msg in msgs %}<div class="flash {{ cat }}">{{ msg }}</div>{% endfor %}
+    {% endwith %}
+    {% block content %}{% endblock %}
+  </main>
+</div>
+{% else %}
+<main class="login-page">
+  {% with msgs = get_flashed_messages(with_categories=true) %}
+    {% for cat, msg in msgs %}<div class="flash {{ cat }}">{{ msg }}</div>{% endfor %}
+  {% endwith %}
+  {% block login %}{% endblock %}
+</main>
+{% endif %}
+</body>
+</html>
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/dashboard.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/dashboard.html
new file mode 100644
index 000000000..ec61a7019
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/dashboard.html
@@ -0,0 +1,76 @@
+{% extends "base.html" %}
+{% block title %}Dashboard{% endblock %}
+{% block content %}
+<h2>Dashboard</h2>
+
+<div class="cards">
+
+  <section class="card">
+    <h3>System</h3>
+    <table class="kv">
+      <tr><th>Hostname</th><td>{{ hostname }}</td></tr>
+      <tr><th>Kernel</th><td>{{ sys.kernel }}</td></tr>
+      <tr><th>Uptime</th><td>{{ sys.uptime }}</td></tr>
+      <tr><th>Load avg</th><td>{{ sys.load|join(' / ') }}</td></tr>
+    </table>
+    {% set m = sys.mem %}
+    {% if m.get('total_mb') %}
+    {% set pct = m.get('used_pct', 0) %}
+    <div class="meter-label">
+      <span>RAM</span>
+      <span>{{ m.used_mb }} / {{ m.total_mb }} MB &middot; {{ m.avail_mb }} MB free</span>
+    </div>
+    <div class="meter">
+      <div class="meter-fill {{ 'crit' if pct >= 90 else 'warn' if pct >= 75 else 'ok' }}"
+           style="width: {{ pct }}%"></div>
+    </div>
+    <p class="muted" style="margin-top:4px">
+      {{ pct }}% used &middot; {{ m.buffcache_mb }} MB buff/cache (reclaimable)
+    </p>
+    {% else %}
+    <p class="muted">{{ m.get('MemAvailable','?') }} free of {{ m.get('MemTotal','?') }}</p>
+    {% endif %}
+  </section>
+
+  <section class="card">
+    <h3>WAN ({{ wan }})</h3>
+    {% set wif = net.ifaces.get(wan, {}) %}
+    <table class="kv">
+      <tr><th>State</th><td>
+        {% if wif.state == 'up' %}<span class="badge ok">UP</span>{% else %}<span class="badge err">{{ wif.state or 'DOWN' }}</span>{% endif %}
+      </td></tr>
+      <tr><th>Address</th><td>{{ wif.addrs|join(', ') if wif.addrs else '(none)' }}</td></tr>
+      <tr><th>Gateway</th><td>{{ net.default_gateway or '(none)' }}</td></tr>
+      <tr><th>DNS</th><td>{{ net.dns|join(', ') if net.dns else '(none)' }}</td></tr>
+      <tr><th>RX / TX</th><td>{{ wif.rx or '0' }} / {{ wif.tx or '0' }}</td></tr>
+    </table>
+  </section>
+
+  <section class="card">
+    <h3>LAN (usb0)</h3>
+    {% set lif = net.ifaces.get('usb0', {}) %}
+    <table class="kv">
+      <tr><th>State</th><td>
+        {% if lif.state == 'up' %}<span class="badge ok">UP</span>{% else %}<span class="badge warn">{{ lif.state or 'DOWN' }}</span>{% endif %}
+      </td></tr>
+      <tr><th>Address</th><td>{{ lif.addrs|join(', ') if lif.addrs else '(none)' }}</td></tr>
+      <tr><th>MAC</th><td>{{ lif.mac }}</td></tr>
+      <tr><th>RX / TX</th><td>{{ lif.rx or '0' }} / {{ lif.tx or '0' }}</td></tr>
+    </table>
+  </section>
+
+  <section class="card">
+    <h3>Reticulum</h3>
+    <table class="kv">
+      <tr><th>Status</th><td>
+        {% if rnsd.running %}<span class="badge ok">RUNNING</span> (pid {{ rnsd.pid }}){% else %}<span class="badge err">STOPPED</span>{% endif %}
+      </td></tr>
+      {% if rnsd.running and rnsd.rss_mb %}
+      <tr><th>rnsd RAM</th><td>{{ rnsd.rss_mb }} MB RSS</td></tr>
+      {% endif %}
+    </table>
+    <p><a class="btn" href="{{ url_for('reticulum') }}">Manage →</a></p>
+  </section>
+
+</div>
+{% endblock %}
diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/login.html b/buildroot/package/rnsbox-portal/src/rnsbox_portal/templates/login.html

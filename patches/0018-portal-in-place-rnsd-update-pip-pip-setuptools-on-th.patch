+    @app.route("/reticulum/applyupdate", methods=["POST"])
+    @login_required
+    def reticulum_applyupdate():
+        # In-place update of the rns package (site-packages only; /etc config
+        # untouched). Backs up first and rolls back if rnsd fails to restart.
+        res = updatecheck.apply_update()
+        if res.get("ok"):
+            flash("rnsd updated %s → %s and restarted."

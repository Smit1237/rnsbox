@@ -0,0 +1,24 @@
+# WAN uplink config — managed by the rnsbox-portal Network tab.
+#
+# Flat key=value. Parsed by both the Flask portal (store.py) and the shell
+# init scripts (S30eth addresses eth0; S60routing picks the NAT iface).
+#
+# interface:  which iface acts as WAN (default route + NAT masquerade attach here)
+#   eth0    - onboard RJ45 (the only working option on the Nano-e SKU; default)
+#   wlan0   - WiFi client (W variant only; addressed by S35wifi/dhcpcd, not here)
+#
+# mode:  how eth0 gets its IPv4 address
+#   dhcp    - lease from the upstream router (default)
+#   static  - use the address/prefix/gateway/dns fields below
+#
+# Static fields (only read when mode=static, only applied to eth0):
+#   address   IPv4 address,         e.g. 192.168.1.50
+#   prefix    netmask as CIDR bits, e.g. 24  (255.255.255.0)
+#   gateway   upstream gateway,     e.g. 192.168.1.1
+#   dns       space-separated DNS servers, e.g. 1.1.1.1 8.8.8.8
+#
+# Changes take effect after `/etc/init.d/S30eth restart` +
+# `/etc/init.d/S60routing restart` (the portal does both on save), or a reboot.
+
+interface=eth0
+mode=dhcp

+# Port forwards (WAN -> LAN DNAT).
+#
+# One rule per line:
+#   <proto>  <wan_port>  <lan_ip>        <lan_port>   [# comment]
+#
+# Examples:
+#   tcp  8080  10.42.0.10  80    # expose host PC's webserver
+#   udp  4242  10.42.0.10  4242  # forward Reticulum UDP to a LAN peer
+#
+# Managed by the rnsbox-portal UI (Network → Port forwards). Hand-edits
+# survive until the next UI write. After hand-editing, apply with:
+#   /etc/init.d/S60routing restart
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wan.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wan.conf
new file mode 100644
index 000000000..c1d3f39ae
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wan.conf
@@ -0,0 +1,27 @@
+# WAN uplink config — managed by the rnsbox-portal Network tab.
+#
+# Flat key=value. Parsed by both the C++ portal (store.cpp, in
+# /usr/sbin/rnsbox-portal — it rewrites this file on save) and the shell init
+# scripts (S30eth addresses eth0 only when interface=eth0; S60routing picks
+# the NAT iface).
+#
+# interface:  which iface acts as WAN (default route + NAT masquerade attach here)
+#   eth0    - onboard RJ45 (the only working option on the Nano-e SKU; default)
+#   wlan0   - WiFi client (W variant only; addressed by S35wifi/dhcpcd, not here).
+#             eth0 is then left unconfigured (no DHCP client, no address).
+#
+# mode:  how eth0 gets its IPv4 address
+#   dhcp    - lease from the upstream router (default)
+#   static  - use the address/prefix/gateway/dns fields below
+#
+# Static fields (only read when mode=static, only applied to eth0):
+#   address   IPv4 address,         e.g. 192.168.1.50
+#   prefix    netmask as CIDR bits, e.g. 24  (255.255.255.0)
+#   gateway   upstream gateway,     e.g. 192.168.1.1
+#   dns       space-separated DNS servers, e.g. 1.1.1.1 8.8.8.8
+#
+# Changes take effect after `/etc/init.d/S30eth restart` +
+# `/etc/init.d/S60routing restart` (the portal does both on save), or a reboot.
+
+interface=eth0
+mode=dhcp
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/sysctl.d/10-rnsbox-hardening.conf b/buildroot/board/cvitek/SG200X/overlay/etc/sysctl.d/10-rnsbox-hardening.conf
new file mode 100644
index 000000000..1d12a856a
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/sysctl.d/10-rnsbox-hardening.conf
@@ -0,0 +1,11 @@
+# RNSBox: standard protections for sticky world-writable dirs. The kernel
+# default for all four is 0. /tmp is a mode-1777 tmpfs, and /var/log,
+# /var/spool, /var/cache and /var/lib/misc are symlinks to it. Root init
+# scripts append to fixed names there (e.g. /var/log/slip.log,
+# /var/log/cron.log). These settings stop a non-root process (dnsmasq runs as
+# nobody) from planting a symlink, hardlink, FIFO or regular file there for
+# root to open. Applied by /etc/init.d/S02sysctl, long before S80dnsmasq.
+fs.protected_symlinks = 1
+fs.protected_hardlinks = 1
+fs.protected_regular = 2
+fs.protected_fifos = 2

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/dhcpcd.conf b/buildroot/board/cvitek/SG200X/overlay/etc/dhcpcd.conf
new file mode 100644
index 000000000..7e13f82e9
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/dhcpcd.conf
@@ -0,0 +1,45 @@
+# dhcpcd config for the RNSBox router.
+#
+# Goal: dhcpcd serves ONLY the WiFi client iface wlan0 (W variant). It runs
+# solely as S35wifi's per-interface instance (`dhcpcd -b -n wlan0`), and only
+# while wlan0 is the STA (mode sta / sta+ap). Nothing runs a dhcpcd manager:
+# in mode=ap wlan0 is the hotspot, and a manager would DHCP on it (see the
+# overlay's S41dhcpcd stub). It never touches eth0 — S30eth owns eth0
+# (udhcpc or static) and only when eth0 is the WAN — nor usb0/wlan1 (LAN,
+# dnsmasq territory) nor sl0 (point-to-point modem link). IPv4 only, and never
+# an IPv4LL/APIPA fallback — we'd rather have no IP than a 169.254.x.x address
+# that the kernel will helpfully install a default route through.
+
+hostname
+clientid
+
+# No `persistent`: when S35wifi stops the client (`dhcpcd -x wlan0`, on a
+# WiFi mode change) dhcpcd must de-configure wlan0 and run its STOP hook, which
+# removes the lease address, its routes and the wlan0.dhcp openresolv entry.
+# (`persistent` only skips that on exit; the per-interface daemon stays
+# resident across WiFi link loss either way.)
+
+option rapid_commit
+option domain_name_servers, domain_name, domain_search
+option classless_static_routes
+require dhcp_server_identifier
+slaac private
+
+# IPv6 exists in the kernel only for usb0 (Reticulum AutoInterface, link-local);
+# S09ipv6 disables it on every other iface. dhcpcd must never try DHCPv6 or
+# router solicitation on the WAN.
+noipv6
+noipv6rs
+
+# No 169.254 fallback. dhcpcd's APIPA route would otherwise become the
+# default route on link-down, which is exactly the bug we hit on the
+# predecessor board.
+noipv4ll
+
+# The only iface dhcpcd may manage. eth0 used to be listed too, so the
+# manager daemon ran a second DHCP client on eth0 next to S30eth's udhcpc —
+# a cable plugged in while WAN=wlan0 then added an eth0 default route that
+# hijacked the WAN. No manager runs any more (S41dhcpcd is a stub), so both
+# lists are belt-and-braces; deny wins over allow.
+allowinterfaces wlan0
+denyinterfaces lo eth0 usb0 wlan1 sl0
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/dnsmasq.conf b/buildroot/board/cvitek/SG200X/overlay/etc/dnsmasq.conf
new file mode 100644
index 000000000..522c6c794
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/dnsmasq.conf
@@ -0,0 +1,31 @@
+# NOTE: this file is REGENERATED AT BOOT by /etc/init.d/S60routing
+# based on /etc/rnsbox/wan.conf. Manual edits below the "AUTOGEN MARKER"
+# line are clobbered every boot.
+#
+# To change the WAN interface, use the portal Network tab, or edit
+# /etc/rnsbox/wan.conf and run
+#   /etc/init.d/S30eth restart && /etc/init.d/S60routing restart
+
+# Shared (interface-agnostic) settings.
+# filter-AAAA: the box has no IPv6 uplink (IPv6 exists only as link-local on
+# usb0, for Reticulum's AutoInterface), so never hand LAN clients AAAA records
+# they can't reach. No enable-ra / DHCPv6 ranges either — dnsmasq does no IPv6
+# address assignment.
+filter-AAAA
+cache-size=1000
+no-hosts
+# bind-dynamic = bind per-interface as they come up, not wildcard-at-start.
+# Lets the autogen section below reference usb0 even if it appears late.
+bind-dynamic
+# DNS upstream follows /etc/resolv.conf (both via openresolv: eth0 by
+# udhcpc/S30eth, wlan0 by dhcpcd).
+
+# Friendly hostnames for the portal regardless of which LAN the client is on.
+# They only redirect to the IP (http://10.42.0.1/): the portal serves content
+# on an IP literal only (DNS-rebinding guard). Keep in sync with main.cpp
+# host_is_alias ALIASES: a name missing there gets a 403 from the portal.
+# (rnsbox.local only works where the client asks unicast DNS for .local names;
+# macOS, iOS and Linux use mDNS for those.)
+address=/rnsbox.local/setup.rnsbox/setup.lan/router.rnsbox/10.42.0.1
+
+# --- AUTOGEN MARKER --- per-LAN scopes appended at boot below ---
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/fstab b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
new file mode 100644
index 000000000..4a0b317d7
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
@@ -0,0 +1,29 @@
+# RNSBox overlay: extend microSD life by mounting log/state dirs
+# as tmpfs (writes never hit flash) and applying noatime where they would.
+# `/` is remounted rw,noatime by inittab si1 — see /etc/inittab.
+#
+# /var/log, /var/cache, /var/spool, /var/tmp (and /var/lib/misc) are Buildroot
+# skeleton symlinks to ../tmp, and /var/lock -> ../run/lock, so the /tmp and
+# /run tmpfs below already cover them. Do NOT add separate tmpfs lines for
+# those paths: mount follows the symlink and stacks a second tmpfs on top of
+# /tmp (the old /var/log + /var/cache lines did exactly that, and the last
+# one left every log sharing a 512 KB tmpfs).
+#
+# /tmp is sized for what lands there: syslog (/var/log/messages, rotated by
+# syslogd at 200 KB x 2 — rnsd/lxmd/nomadnet log into it), the other small
+# init-script logs and the dnsmasq leases. The size is a cap, not a
+# reservation — tmpfs only uses RAM for what is actually stored. (The cron
+# spool is on /run, see S84cron.)
+# /tmp is mode 1777, so the sticky-dir symlink/FIFO protections are switched on
+# in /etc/sysctl.d/10-rnsbox-hardening.conf.
+
+# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
+/dev/root	/		ext2	rw,noauto,noatime			0	1
+proc		/proc		proc	defaults				0	0
+devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
+sysfs		/sys		sysfs	defaults				0	0
+
+# Memory-backed mounts — kill SD writes from the chatty paths.
+tmpfs		/dev/shm	tmpfs	mode=0777				0	0
+tmpfs		/tmp		tmpfs	mode=1777,size=16M			0	0
+tmpfs		/run		tmpfs	mode=0755,nosuid,nodev			0	0
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
index d30bc52c1..5bf026886 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
@@ -1,33 +1,190 @@
 #!/bin/sh
+# S30eth — bring up the WAN on eth0 with either a DHCP lease or a static
+# address, per /etc/rnsbox/wan.conf — but ONLY when eth0 is the WAN
+# (interface=eth0, the default).
+#
+# DHCP path: busybox udhcpc (its default.script sets the lease addr/route and
+#   registers the lease DNS with openresolv as "eth0"). Backgrounded;
+#   persists, retries on late carrier. It doesn't notice a cable moved to
+#   another network, so S46wanwatch runs `renew` when the carrier comes back:
+#   udhcpc restarts asking for its old address — a brief WAN re-acquire; the
+#   same network re-grants the same address, another one leases a new one.
+# Static path: `ip` assigns addr/route directly and we register the static
+#   DNS with openresolv as "eth0" ourselves.
+# Either way resolv.conf is generated by openresolv from its database, the
+#   same one dhcpcd feeds for a wlan0 STA — so neither writer's regeneration
+#   drops the other's servers (dnsmasq + the box's own resolver follow it).
+#
+# interface=wlan0 (W variant; S35wifi + dhcpcd address wlan0): eth0 is left
+#   unconfigured — no DHCP client, no address, no route. Otherwise a cable in
+#   eth0 would add udhcpc's metric-0 default route and hijack the WiFi WAN.
+#   udhcpc here is eth0's only DHCP client (dhcpcd.conf no longer lists eth0).
+#
+# `restart` (the portal runs it, then S60routing, on every WAN save) always
+# tears eth0 down first, so eth0 <-> wlan0 and dhcp <-> static switches end
+# clean both ways.
+#
+# /boot/eth.nodhcp still forces "leave eth0 alone" (legacy escape hatch).
 
 . /etc/profile
 
+WAN_CONF=/etc/rnsbox/wan.conf
+RESOLV=/etc/resolv.conf
+REQUEST_IP=                  # set by renew: the address udhcpc asks for (-r)
+
+cfg() {
+	# value for key $1 from wan.conf (strip comments/space); empty if absent
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$WAN_CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+wan_iface() {
+	# Same rules as S60routing read_wan(): the interface= key, else a legacy
+	# bare "eth0"/"wlan0" line, else eth0.
+	w=$(cfg interface | tr -d '[:space:]')
+	[ -z "$w" ] && w=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$|=' "$WAN_CONF" 2>/dev/null | head -1 | tr -d '[:space:]')
+	case "$w" in eth0|wlan0) echo "$w" ;; *) echo eth0 ;; esac
+}
+
+eth0_udhcpc_pids() {
+	# Every udhcpc bound to eth0 (argv has " -i eth0 "), whatever the pidfile says.
+	for pid in $(pidof udhcpc); do
+		case "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
+			*" -i eth0 "*) echo "$pid" ;;
+		esac
+	done
+}
+
+stop_dhcp() {
+	# Kill every udhcpc bound to eth0, not just the one in our pidfile — a
+	# stray client (repeated `start`, stale pidfile) would otherwise keep
+	# re-adding its lease + default route behind our back.
+	# udhcpc runs without -R, so it leaves its lease/route behind on SIGTERM —
+	# stop() flushes eth0 afterwards.
+	for pid in $(eth0_udhcpc_pids); do
+		kill "$pid" 2>/dev/null
+	done
+	rm -f /run/udhcpc.eth0.pid
+}
+
+# dhcp_wan — true when start() would run udhcpc: no /boot/eth.nodhcp,
+# interface=eth0, and not static with an address (an empty static address
+# falls back to DHCP).
+dhcp_wan() {
+	[ ! -e /boot/eth.nodhcp ] && [ "$(wan_iface)" = eth0 ] || return 1
+	[ "$(cfg mode)" != static ] || [ -z "$(cfg address)" ]
+}
+
+# renew — S46wanwatch runs this when eth0's carrier comes back (cable
+# re-plugged, maybe into another network). udhcpc doesn't watch carrier, so
+# the old lease + default route would otherwise stay until T1/T2. Restart
+# it, as dhcpcd does on carrier-up, asking for the address eth0 held (-r:
+# busybox puts it in the DISCOVER as the requested-IP option, nothing more).
+# The same network re-grants it; another network ignores the hint and offers
+# its own address. Either way the WAN is back after a brief outage; a silent
+# network leaves udhcpc retrying in the background, as at boot. No-op unless
+# eth0 is the DHCP WAN. Nothing for S60routing to redo: the ruleset names
+# ifaces, not addresses.
+renew() {
+	dhcp_wan || return 0
+	REQUEST_IP=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{sub("/.*", "", $4); print $4; exit}')
+	echo "eth0 renew: restarting udhcpc${REQUEST_IP:+, asking for $REQUEST_IP}"
+	stop
+	start
+}
+
+strip_resolv() {
+	# Drop eth0's entry from openresolv's database (udhcpc's default.script and
+	# start_static both register as "eth0"); openresolv regenerates resolv.conf
+	# from what's left, e.g. dhcpcd's wlan0.dhcp. No-op if eth0 had no entry.
+	resolvconf -d eth0 -f 2>/dev/null
+}
+
+start_dhcp() {
+	stop_dhcp   # never run two clients on eth0 (e.g. `start` issued twice)
+	# -t tries, -T timeout, -A wait-before-retry, -b background after lease fail
+	# -x hostname: send DHCP option 12 (udhcpc sends none by default). dhcpcd's
+	#   `hostname` used to cover eth0 back when dhcpcd also ran there; without
+	#   it the upstream router's lease/DNS no longer knows the box by name. An
+	#   empty value is skipped by udhcpc, not fatal. (Keep "-i eth0" followed
+	#   by another argument: stop_dhcp matches " -i eth0 ".)
+	# -r (renew only): the address to ask for, see renew.
+	(udhcpc -i eth0 -x hostname:"$(hostname)" -t 10 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid \
+	  ${REQUEST_IP:+-r "$REQUEST_IP"}) &
+	echo "dhcp"
+}
+
+start_static() {
+	addr=$(cfg address); prefix=$(cfg prefix); gw=$(cfg gateway); dns=$(cfg dns)
+	[ -z "$prefix" ] && prefix=24
+	if [ -z "$addr" ]; then
+		echo "static requested but address empty — falling back to dhcp"
+		start_dhcp
+		return
+	fi
+	ip addr flush dev eth0 2>/dev/null
+	ip addr add "$addr/$prefix" dev eth0 2>/dev/null
+	ip link set eth0 up 2>/dev/null
+	if [ -n "$gw" ]; then
+		# replace (not del+add): swaps out any metric-0 default but leaves
+		# dhcpcd's wlan0 default (metric 3000+) alone if the STA is also up.
+		ip route replace default via "$gw" dev eth0 2>/dev/null
+	fi
+	# Register the static DNS servers with openresolv as the eth0 entry, so
+	# dnsmasq (upstream) + the box's own resolver use them and a dhcpcd event on
+	# a wlan0 STA (resolvconf -a wlan0.dhcp) can't regenerate them away.
+	# Exclusive: only the operator's servers are listed while this is set.
+	# The touch lets openresolv back up an empty file, not a stale
+	# /etc/resolv.conf.bak from an earlier boot.
+	if [ -n "$dns" ]; then
+		[ -e "$RESOLV" ] || : > "$RESOLV"
+		for s in $dns; do echo "nameserver $s"; done | IF_EXCLUSIVE=yes resolvconf -a eth0
+	fi
+	echo "static $addr/$prefix gw=${gw:-none} dns=${dns:-none}"
+}
+
 start() {
 	printf "start ethernet: "
-	if [ ! -e /boot/eth.nodhcp ]
-	then
-		(udhcpc -i eth0 -t 10 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid) &
+	# openresolv restores /etc/resolv.conf.bak (on the SD rootfs) whenever its
+	# database empties; the live resolv.conf is in /tmp, so a .bak left from an
+	# earlier boot is always stale. Drop it before anything registers this boot
+	# (/run/resolvconf, openresolv's state dir, doesn't exist yet then).
+	[ -d /run/resolvconf ] || rm -f /etc/resolv.conf.bak
+	if [ -e /boot/eth.nodhcp ]; then
+		echo "skipped (/boot/eth.nodhcp present)"
+		return
 	fi
-	echo "OK"
+	iface=$(wan_iface)
+	if [ "$iface" != "eth0" ]; then
+		# (stop's strip_resolv already regenerated resolv.conf from dhcpcd's
+		# wlan0 entry when the WAN moved off eth0.)
+		echo "skipped (WAN=$iface — eth0 left unconfigured)"
+		return
+	fi
+	mode=$(cfg mode); [ -z "$mode" ] && mode=dhcp
+	case "$mode" in
+		static) start_static ;;
+		*)      start_dhcp ;;
+	esac
 }
 
 stop() {
-	kill `cat /run/udhcpc.eth0.pid`
-	rm /run/udhcpc.eth0.pid
+	# Stop the DHCP client(s), whatever wan.conf says now (the WAN may have
+	# just been switched away from eth0).
+	stop_dhcp
+	# Drop any static addressing too, so a mode switch starts clean. Removing
+	# eth0's last IPv4 address also removes every route through it, the
+	# default route included.
+	ip addr flush dev eth0 2>/dev/null
+	strip_resolv
 }
 
-restart() {
-	start
-	stop
-}
-
-if [ "${1}" = "start" ]
-then
-	start
-elif [ "${1}" = "stop" ]
-then
-	stop
-elif [ "${1}" = "restart" ]
-then
-	restart
-fi
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; start ;;        # NB: real order (old S30eth had it backwards)
+	renew)   renew ;;
+	dhcpwan) dhcp_wan ;;           # exit 0 iff eth0 is the DHCP WAN (S46wanwatch)
+	*)       echo "Usage: $0 {start|stop|restart|renew|dhcpwan}" >&2; exit 1 ;;
+esac
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S41dhcpcd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S41dhcpcd
new file mode 100755
index 000000000..c8514d64a
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S41dhcpcd
@@ -0,0 +1,16 @@
+#!/bin/sh
+# RNSBox: no dhcpcd manager daemon. S35wifi starts a per-interface
+# `dhcpcd -b -n wlan0` only when wlan0 is a WiFi client (mode sta / sta+ap)
+# and stops it with `dhcpcd -x wlan0`. A manager (dhcpcd -f with no iface)
+# would activate wlan0 even when it is the hotspot (mode=ap: hostapd gives it
+# carrier). It would then send DHCP to hotspot clients, and any client that
+# answered could push a default route and upstream DNS (openresolv ->
+# dnsmasq) onto the box. At boot in sta mode it also ran a second DHCP client
+# on wlan0 that `dhcpcd -x wlan0` did not stop.
+#
+# This overlay file replaces the dhcpcd package's S41dhcpcd (the overlay is
+# copied in target-finalize, after packages install).
+case "$1" in
+	start|stop|restart|reload|force-reload) exit 0 ;;
+	*) echo "Usage: $0 {start|stop|restart|reload|force-reload}"; exit 1 ;;
+esac
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing
new file mode 100755
index 000000000..7531b48bc
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing
@@ -0,0 +1,167 @@
+#!/bin/sh
+# S60routing — kernel routing knobs + regenerate nftables.conf and the
+# per-LAN dnsmasq scope, then apply.
+#
+# Runs after S30gadget_nic (usb0), S30eth (eth0 lease) and S35wifi (so an
+# AP iface, if any, already exists and can be folded into the LAN side).
+# Re-runnable as `restart` whenever the portal edits the rnsbox configs.
+#
+# nftables ruleset comes from `python3 -m rnsbox_portal.nftgen` (single
+# source of truth shared with the Flask UI). Pre-validate with `nft -c -f`
+# (validate-before-swap discipline) before atomically swapping the live config so a bad
+# generated rule can't lock us out.
+
+WAN_CONF=/etc/rnsbox/wan.conf
+NFT_FILE=/etc/nftables.conf
+DNSMASQ_FILE=/etc/dnsmasq.conf
+NFTGEN="env PYTHONPATH=/usr/lib/rnsbox-portal python3 -m rnsbox_portal.nftgen"
+
+USB0_LAN_IP=10.42.0.1
+USB0_LAN_DHCP_START=10.42.0.10
+USB0_LAN_DHCP_END=10.42.0.20
+AUTOGEN_DNSMASQ="# --- AUTOGEN MARKER --- per-LAN scopes appended at boot below ---"
+
+# RNSBox W variant: S35wifi writes the AP iface name to /run/wifi-ap-iface
+# when a hotspot is up. Fold it into the LAN side so it gets NAT + a DHCP
+# scope automatically. WiFi subnet read from /etc/rnsbox/wifi.conf.
+WIFI_CONF=/etc/rnsbox/wifi.conf
+wifi_cfg() {
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$WIFI_CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+read_wan() {
+	# wan.conf is now key=value (interface=eth0). Prefer the interface= key;
+	# fall back to a legacy bare "eth0"/"wlan0" line if no key is present.
+	WAN=$(grep -E '^[[:space:]]*interface[[:space:]]*=' "$WAN_CONF" 2>/dev/null \
+	  | tail -1 | sed -E 's/^[^=]*=[[:space:]]*//' | sed -E 's/[[:space:]]*#.*$//' \
+	  | tr -d '[:space:]')
+	[ -z "$WAN" ] && WAN=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$|=' "$WAN_CONF" 2>/dev/null | head -1 | tr -d '[:space:]')
+	case "$WAN" in eth0|wlan0) ;; *) WAN=eth0 ;; esac
+}
+
+read_lan() {
+	LAN_IFACES="usb0"
+	AP_IF=""
+	if [ -r /run/wifi-ap-iface ]; then
+		AP_IF=$(cat /run/wifi-ap-iface 2>/dev/null | tr -d '[:space:]')
+		[ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ] && LAN_IFACES="usb0,$AP_IF"
+	fi
+}
+
+regen_nftables() {
+	TMP=$(mktemp /tmp/nftables.conf.XXXXXX) || return 1
+	if ! $NFTGEN --wan "$WAN" --lan "$LAN_IFACES" > "$TMP" 2>/var/log/nftgen.err; then
+		echo "S60routing: nftgen failed (see /var/log/nftgen.err); keeping previous $NFT_FILE"
+		rm -f "$TMP"
+		return 1
+	fi
+	if ! nft -c -f "$TMP" >>/var/log/nftgen.err 2>&1; then
+		echo "S60routing: generated ruleset failed nft -c validation; keeping previous $NFT_FILE"
+		rm -f "$TMP"
+		return 1
+	fi
+	mv "$TMP" "$NFT_FILE"
+	chmod 0644 "$NFT_FILE"
+}
+
+regen_dnsmasq() {
+	if grep -q "$AUTOGEN_DNSMASQ" "$DNSMASQ_FILE" 2>/dev/null; then
+		sed -i "/$AUTOGEN_DNSMASQ/q" "$DNSMASQ_FILE"
+	fi
+	{
+		echo
+		echo "# WAN=$WAN (DHCP not served here — eth0 receives a lease, doesn't serve one)"
+		echo "no-dhcp-interface=$WAN"
+		echo
+		echo "# usb0 LAN"
+		echo "interface=usb0"
+		echo "dhcp-range=set:usb0,$USB0_LAN_DHCP_START,$USB0_LAN_DHCP_END,255.255.255.0,12h"
+		echo "dhcp-option=tag:usb0,3,$USB0_LAN_IP"
+		echo "dhcp-option=tag:usb0,6,$USB0_LAN_IP"
+		# RNSBox W variant: AP hotspot scope (only when S35wifi has an AP up).
+		if [ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ]; then
+			AP_IP=$(wifi_cfg ap_ip); [ -z "$AP_IP" ] && AP_IP=192.168.42.1
+			AP_DS=$(wifi_cfg ap_dhcp_start); [ -z "$AP_DS" ] && AP_DS=192.168.42.10
+			AP_DE=$(wifi_cfg ap_dhcp_end); [ -z "$AP_DE" ] && AP_DE=192.168.42.100
+			echo
+			echo "# $AP_IF WiFi AP LAN"
+			echo "interface=$AP_IF"
+			echo "dhcp-range=set:$AP_IF,$AP_DS,$AP_DE,255.255.255.0,12h"
+			echo "dhcp-option=tag:$AP_IF,3,$AP_IP"
+			echo "dhcp-option=tag:$AP_IF,6,$AP_IP"
+		fi
+	} >> "$DNSMASQ_FILE"
+}
+
+start() {
+	read_wan
+	read_lan
+	echo "S60routing: WAN=$WAN LAN=$LAN_IFACES"
+
+	# --- routing knobs ---
+	echo 1 > /proc/sys/net/ipv4/ip_forward
+	echo 0 > /proc/sys/net/ipv4/conf/all/rp_filter
+	echo 0 > /proc/sys/net/ipv4/conf/default/rp_filter
+	echo 0 > /proc/sys/net/ipv4/conf/all/accept_redirects
+	echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
+	# route_localnet on the WAN iface: lets a port forward whose target is a
+	# loopback address (127.0.0.0/8 — e.g. a service that binds only to
+	# 127.0.0.1) actually be delivered. Without it, a packet DNAT'd to 127.x
+	# arriving on a real iface is dropped as a martian before INPUT. Forwards
+	# to the box's real LAN IP (10.42.0.1) don't need this; loopback ones do.
+	# Safe: INPUT's drop policy + the "ct status dnat" gate mean only flows
+	# our own prerouting DNAT created can reach a local service this way.
+	echo 1 > "/proc/sys/net/ipv4/conf/$WAN/route_localnet" 2>/dev/null || true
+
+	# --- throughput tuning ---
+	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
+		[ -w "$g" ] && echo performance > "$g" 2>/dev/null
+	done
+	echo 4194304 > /proc/sys/net/core/rmem_max
+	echo 4194304 > /proc/sys/net/core/wmem_max
+	echo 1048576 > /proc/sys/net/core/rmem_default
+	echo 1048576 > /proc/sys/net/core/wmem_default
+	echo "4096 1048576 4194304" > /proc/sys/net/ipv4/tcp_rmem
+	echo "4096 524288 4194304"  > /proc/sys/net/ipv4/tcp_wmem
+	echo 4000 > /proc/sys/net/core/netdev_max_backlog
+	echo 600 > /proc/sys/net/core/netdev_budget 2>/dev/null
+	echo 8000 > /proc/sys/net/core/netdev_budget_usecs 2>/dev/null
+	echo 0 > /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null
+	echo 15 > /proc/sys/net/ipv4/tcp_fin_timeout 2>/dev/null
+	echo 1 > /proc/sys/net/ipv4/tcp_tw_reuse 2>/dev/null
+	echo 3 > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null
+	if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
+		echo bbr > /proc/sys/net/ipv4/tcp_congestion_control
+	fi
+	[ -d /sys/module/sch_fq ] || modprobe sch_fq 2>/dev/null
+	echo fq > /proc/sys/net/core/default_qdisc 2>/dev/null
+
+	# --- regenerate + apply ---
+	regen_dnsmasq
+	regen_nftables
+
+	nft flush ruleset 2>/dev/null
+	if [ -r "$NFT_FILE" ]; then
+		nft -f "$NFT_FILE"
+	fi
+
+	if [ -x /etc/init.d/S80dnsmasq ]; then
+		/etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
+	elif pidof dnsmasq >/dev/null 2>&1; then
+		killall -HUP dnsmasq 2>/dev/null || true
+	fi
+}
+
+stop() {
+	nft flush ruleset 2>/dev/null || true
+	echo 0 > /proc/sys/net/ipv4/ip_forward
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; start ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/nftables.conf b/buildroot/board/cvitek/SG200X/overlay/etc/nftables.conf
new file mode 100644
index 000000000..d7a10da0d
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/nftables.conf
@@ -0,0 +1,78 @@
+# /etc/nftables.conf — REGENERATED AT BOOT by /etc/init.d/S60routing.
+#
+# What ships here is only a static FALLBACK: it is what S60routing loads if
+# `/usr/sbin/rnsbox-portal nftgen` fails before it has ever produced a ruleset
+# (a broken portal binary on first boot). Once nftgen succeeds this file is
+# replaced by its output, and later failures keep the last good generated file
+# if it was generated for the same WAN/LAN (else the emergency ruleset).
+#
+# It fails CLOSED toward the WAN and needs no WAN iface name:
+#   - LAN ifaces (usb0; wlan1 = the concurrent-mode hotspot vif, only ever an
+#     AP) keep full access, so SSH / the web UI stay reachable over USB-C to
+#     repair things. An AP-only hotspot runs on wlan0, which a static file
+#     can't tell apart from a wlan0 WAN, so it counts as non-LAN here;
+#   - every other iface (eth0, wlan0, sl0, ...) reaches nothing on the box:
+#     no port forwards, no open ports and — unlike the generated ruleset — no
+#     WAN SSH;
+#   - LAN clients keep internet: forwarded + masqueraded out of eth0 and
+#     wlan0 (the only possible WANs, whichever it is). Nothing else, e.g. sl0
+#     (the HaLow modem), is reachable from the LAN.
+# The ip6 table needs a kernel with IPv6 (nft -f is all-or-nothing). If this
+# whole file fails to load, S60routing installs its built-in IPv4-only
+# emergency ruleset instead (same LAN-only policy); see S60routing.
+#
+# Re-render the live config (after editing /etc/rnsbox/*.conf) via:
+#   /etc/init.d/S60routing restart
+
+flush ruleset
+
+table ip filter {
+	set lan_ifaces { type ifname; elements = { "usb0", "wlan1" } }
+
+	chain input {
+		type filter hook input priority filter; policy drop;
+		ct state invalid drop
+		ct state established,related accept
+		iifname "lo" accept
+		# LAN: full surface (HTTP UI, SSH, DHCP, DNS, etc.)
+		iifname @lan_ifaces accept
+	}
+
+	chain forward {
+		type filter hook forward priority filter; policy drop;
+		ct state invalid drop
+		ct state established,related accept
+		# LAN -> uplink. Only eth0/wlan0 can ever be the WAN (S60routing
+		# WAN_CANDIDATES), so name them: sl0 (the HaLow modem) and any other
+		# iface stay unreachable from the LAN, as in the generated ruleset.
+		iifname @lan_ifaces oifname { "eth0", "wlan0" } accept
+	}
+
+	chain output { type filter hook output priority filter; policy accept; }
+}
+
+table ip nat {
+	chain postrouting {
+		type nat hook postrouting priority srcnat; policy accept;
+		oifname { "eth0", "wlan0" } masquerade
+	}
+}
+
+table ip6 filter {
+	set lan_ifaces { type ifname; elements = { "usb0", "wlan1" } }
+
+	chain input {
+		type filter hook input priority filter; policy drop;
+		ct state invalid drop
+		ct state established,related accept
+		iifname "lo" accept
+		iifname @lan_ifaces icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
+		iifname @lan_ifaces accept
+	}
+
+	chain forward {
+		type filter hook forward priority filter; policy drop;
+	}
+
+	chain output { type filter hook output priority filter; policy accept; }
+}
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/openports.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/openports.conf

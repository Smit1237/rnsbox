+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/openports.conf
@@ -0,0 +1,14 @@
+# Open ports on this device's WAN-facing interface.
+#
+# One rule per line:
+#   <proto>  <port>   [# comment]
+#
+# SSH (22) and the web UI (80) ship as default entries so the box is reachable
+# on the WAN out of the box. Remove them here (or in the portal: Network ->
+# Open ports) to close WAN access — the LAN side (usb0) always stays open.
+#
+# Add rnsd's TCPServerInterface port (default 4242) if you want external
+# Reticulum peers to reach you.
+# Managed by the rnsbox-portal UI (Network -> Open ports).
+tcp 22  # SSH
+tcp 80  # web admin UI

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
index 4e484c094..5d39cb2ac 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
@@ -40,6 +40,17 @@
 # than `rnsd | logger &` so that $! — and so /var/run/rnsd.pid, which the
 # portal and S46wanwatch read — is the rnsd process itself, not logger.
 #
+# Process group: rnsd leads a session and process group of its own
+# (setsid; its pid is still $! and the pidfile's), so stop can end
+# everything rnsd started (a PipeInterface's command, say) along with it,
+# and nothing is tied to the caller's terminal. If rnsd exits on its own
+# (a crash, the OOM killer, a restart killed partway through stop), what it
+# started keeps running; the next start or stop ends that too (see
+# reap_dead_group), so a kick after a crash doesn't leave a PipeInterface
+# command holding its port or serial device until reboot. Neither rnsd nor
+# logger keeps the caller's stdin/stdout/stderr: `S82rnsd restart | tee`
+# over SSH used to hang until rnsd exited.
+#
 # Secrets: rnsd keeps its transport identity (a private key) under
 # /etc/reticulum/storage. It runs with umask 077, and start() tightens any
 # file an older build left group/world-readable (plus the config dir itself,
@@ -68,6 +79,8 @@ STOPPED_MARK=/run/rnsd.stopped
 ARMED_MARK=/run/rnsd.armed
 # Present once this boot's full permission walk over storage/ succeeded.
 PERMS_MARK=/run/rnsd-perms-done
+# The logger reading $LOGPIPE (start), ended by stop if rnsd's exit leaves it.
+LOGGER_PIDFILE=/var/run/$NAME.logger.pid
 # start() sets a path table aside only when it is dated more than this far
 # after the current clock (see there).
 CLOCK_SLACK=3600
@@ -108,6 +121,76 @@ rnsd_pid() {
 	return 1
 }
 
+# pstat PID — PSTATE, PPGRP and PSID = PID's state, process group and
+# session (fields 3, 5 and 6 of /proc/PID/stat, counted after comm's last
+# ")": comm may hold spaces); false once PID is gone. Builtins only. Same as
+# S83nomadnet/S85lxmd, plus PSID.
+pstat() {
+	PSTATE=; PPGRP=; PSID=
+	case "$1" in ''|*[!0-9]*) return 1 ;; esac
+	_s=
+	{ read -r _s <"/proc/$1/stat"; } 2>/dev/null || return 1
+	set -- ${_s##*) }
+	PSTATE=$1; PPGRP=$3; PSID=$4
+}
+
+# group_alive PGID — true while process group PGID has a member that has not
+# exited (a zombie holds nothing open). Builtins only.
+group_alive() {
+	for _d in /proc/[0-9]*; do
+		pstat "${_d#/proc/}" && [ "$PPGRP" = "$1" ] && [ "$PSTATE" != Z ] && return 0
+	done
+	return 1
+}
+
+# reap_dead_group — SIGKILL what an rnsd that exited on its own left running;
+# true (REAPED = its pid) if there was any. start ran rnsd as the leader of a
+# session and process group numbered by the pid in $PIDFILE, and the kernel
+# never hands that number out again while any process still has it as its
+# group or session. So once that pid is gone (or a zombie), live processes
+# whose group and session are both that number are what rnsd started. A live
+# process at that pid is not rnsd (callers have checked), so the pid was
+# reused and the group, if any, is not rnsd's. SIGKILL, not SIGTERM, as in
+# stop: a fork would run rnsd's inherited Python SIGTERM handler. Callers run
+# this while $PIDFILE still names the exited rnsd: start before it records
+# the new one, stop before removing it. Costs one /proc scan, and only when
+# the pidfile names a pid that is gone.
+reap_dead_group() {
+	REAPED=
+	_p=
+	{ read -r _p <"$PIDFILE"; } 2>/dev/null
+	case "$_p" in ''|*[!0-9]*) return 1 ;; esac
+	pstat "$_p" && [ "$PSTATE" != Z ] && return 1
+	_hit=
+	for _d in /proc/[0-9]*; do
+		pstat "${_d#/proc/}" && [ "$PPGRP" = "$_p" ] && [ "$PSID" = "$_p" ] \
+			&& [ "$PSTATE" != Z ] && { _hit=1; break; }
+	done
+	[ -n "$_hit" ] || return 1
+	kill -KILL "-$_p" 2>/dev/null
+	logger -t S82rnsd -p daemon.notice "rnsd (pid $_p) had exited, leaving processes it started running - killed them" 2>/dev/null
+	# up to 1 s for them to be gone (and so to close the FIFO)
+	_i=0
+	while group_alive "$_p" && [ "$_i" -lt 5 ]; do
+		sleep 0.2; _i=$((_i + 1))
+	done
+	REAPED=$_p
+}
+
+# logger_pid — print the logger start ran for rnsd's output, while
+# $LOGGER_PIDFILE names one: comm "logger" and an "rnsd[<pid>]" tag in its
+# argv (a zombie's argv reads empty), so a recycled pid never matches.
+logger_pid() {
+	l=
+	{ read -r l <"$LOGGER_PIDFILE"; } 2>/dev/null
+	case "$l" in ''|*[!0-9]*) return 1 ;; esac
+	c=
+	{ read -r c <"/proc/$l/comm"; } 2>/dev/null
+	[ "$c" = logger ] || return 1
+	tr '\0' '\n' <"/proc/$l/cmdline" 2>/dev/null | grep -q "^$NAME\[[0-9]*\]\$" || return 1
+	echo "$l"
+}
+
 # usb0_ll — true once usb0 has a usable IPv6 link-local address (scope 0x20,
 # DAD done: neither tentative 0x40 nor dadfailed 0x08), read from
 # /proc/net/if_inet6 with builtins only. Same test as S46wanwatch.
@@ -210,23 +293,39 @@ start() {
 		rm -f "$LL_MARK"
 	fi
 
+	# No rnsd is running. If the last one exited on its own (S46wanwatch's kick
+	# after a crash, say), end what it left running before its number in
+	# $PIDFILE is overwritten below - the only record of it.
+	reap_dead_group && echo "S82rnsd: killed what the exited rnsd (pid $REAPED) left running"
+
 	printf "Starting %s: " "$NAME"
 	# --config points at our config dir; rnsd auto-creates files inside.
 	# The subshell sets umask 077 + PYTHONUNBUFFERED for rnsd only and exec's
-	# it, so $! is rnsd's pid. Its open of the FIFO completes once logger opens
-	# the read end.
-	rm -f "$LOGPIPE"
+	# setsid, which exec's rnsd, so $! is rnsd's pid - and, setsid having
+	# made it a session and group leader, its process group (see stop).
+	# busybox setsid forks only when its caller leads a process group, and
+	# the backgrounded subshell never does (no job control in a script).
+	# Without setsid rnsd still runs, and stop signals it alone. rnsd's open
+	# of the FIFO completes once logger opens the read end. stdin is
+	# /dev/null, rnsd writes only to the FIFO and logger only to syslog:
+	# nothing keeps the caller's stdin/stdout/stderr. logger gets a session of
+	# its own too; a logger left by an rnsd that died goes first.
+	SETSID=
+	command -v setsid >/dev/null 2>&1 && SETSID=setsid
+	LPID=$(logger_pid) && kill "$LPID" 2>/dev/null
+	rm -f "$LOGPIPE" "$LOGGER_PIDFILE"
 	if command -v logger >/dev/null 2>&1 && mkfifo -m 600 "$LOGPIPE" 2>/dev/null; then
 		(
 			umask 077
 			export PYTHONUNBUFFERED=1
-			exec "$DAEMON" --config "$CFG_DIR"
-		) 9>&- >"$LOGPIPE" 2>&1 &
+			exec $SETSID "$DAEMON" --config "$CFG_DIR"
+		) 9>&- </dev/null >"$LOGPIPE" 2>&1 &
 		PID=$!
-		logger -t "$NAME[$PID]" -p daemon.notice 9>&- <"$LOGPIPE" &
+		$SETSID logger -t "$NAME[$PID]" -p daemon.notice 9>&- <"$LOGPIPE" >/dev/null 2>&1 &
+		echo $! > "$LOGGER_PIDFILE"
 	else
 		# no logger/FIFO: run unlogged rather than not at all
-		( umask 077; exec "$DAEMON" --config "$CFG_DIR" ) 9>&- >/dev/null 2>&1 &
+		( umask 077; exec $SETSID "$DAEMON" --config "$CFG_DIR" ) 9>&- </dev/null >/dev/null 2>&1 &
 		PID=$!
 	fi
 	echo "$PID" > "$PIDFILE"
@@ -243,7 +342,13 @@ start() {
 stop() {
 	printf "Stopping %s: " "$NAME"
 	rm -f "$LL_MARK"
+	LPID=$(logger_pid)
 	if PID=$(rnsd_pid); then
+		# rnsd's process group, if start made rnsd its leader (setsid): all
+		# rnsd started is in it. Otherwise rnsd is signalled alone, never the
+		# group it shares with whoever started it.
+		GRP=
+		pstat "$PID" && [ "$PPGRP" = "$PID" ] && GRP=$PID
 		kill "$PID" 2>/dev/null
 		# Reticulum drains active links on SIGTERM and then persists its path
 		# table, packet hashlist and known destinations. That is pure Python and
@@ -251,27 +356,49 @@ stop() {
 		# until the pid is really gone: if stop returned while rnsd was still
 		# exiting, restart's start() would find it (comm is still "rnsd"),
 		# adopt it, and leave nothing running once it exits. 18 s plus the
-		# SIGKILL fallback keeps one restart at ~21 s on its own, inside the
-		# 25 s web::run_init allows; updatecheck.py allows RESTART_TIMEOUT
-		# (50 s) because the lock below can queue it, for up to 25 s, behind
-		# another S82rnsd operation. (A SIGKILL mid-persist can only truncate
-		# destination_table/tunnels/packet_hashlist.raw, which RNS discards on
-		# load and rebuilds; known_destinations is replaced atomically.)
-		# (logger exits by itself when rnsd's end of the FIFO closes.)
+		# SIGKILL fallback (at most 1 s more) keeps one restart at ~21 s on its
+		# own, inside the 25 s web::run_init allows; updatecheck.py allows
+		# RESTART_TIMEOUT (50 s) because the lock below can queue it, for up to
+		# 25 s, behind another S82rnsd operation. (A SIGKILL mid-persist can
+		# only truncate destination_table/tunnels/packet_hashlist.raw, which RNS
+		# discards on load and rebuilds; known_destinations is replaced
+		# atomically.)
 		i=0
 		while kill -0 "$PID" 2>/dev/null && [ "$i" -lt 18 ]; do
 			sleep 1; i=$((i + 1))
 		done
-		if kill -0 "$PID" 2>/dev/null && is_rnsd "$PID"; then
+		# Then SIGKILL whatever is left of the group - rnsd if it overran, and
+		# anything it started that outlived it (still holding the FIFO, and so
+		# logger). SIGKILL, not SIGTERM, for those too: a fork would run
+		# rnsd's inherited Python SIGTERM handler.
+		if [ -n "$GRP" ]; then
+			group_alive "$GRP" && kill -KILL "-$GRP" 2>/dev/null
+		elif kill -0 "$PID" 2>/dev/null && is_rnsd "$PID"; then
 			kill -9 "$PID" 2>/dev/null
-			sleep 1
 		fi
+		# Up to 1 s for all of it to be gone. logger reads EOF and exits once
+		# the last writer of the FIFO has; one still running then (a writer
+		# outside the group) is killed.
+		i=0
+		while [ "$i" -lt 5 ]; do
+			kill -0 "$PID" 2>/dev/null || { [ -n "$GRP" ] && group_alive "$GRP"; } \
+				|| { [ -n "$LPID" ] && [ "$(logger_pid)" = "$LPID" ]; } || break
+			sleep 0.2; i=$((i + 1))
+		done
+		[ -n "$LPID" ] && [ "$(logger_pid)" = "$LPID" ] && kill "$LPID" 2>/dev/null
 		rm -f "$PIDFILE"
 		echo "OK"
 	else
+		# rnsd exited on its own: end what it left running (reap_dead_group).
+		# That can take up to 1 s, so logger is re-checked before it is killed.
+		MSG="(not running)"
+		reap_dead_group && MSG="(not running; killed what pid $REAPED left running)"
 		rm -f "$PIDFILE"
-		echo "(not running)"
+		# no rnsd left to log for
+		[ -n "$LPID" ] && [ "$(logger_pid)" = "$LPID" ] && kill "$LPID" 2>/dev/null
+		echo "$MSG"
 	fi
+	rm -f "$LOGGER_PIDFILE"
 }
 
 # Serialize start/stop/restart on one lock. S46wanwatch runs `kick` whenever
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S83nomadnet b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S83nomadnet
index 87342fa9a..81bdf04eb 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S83nomadnet
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S83nomadnet
@@ -32,16 +32,23 @@
 # and with unbuffered stdout/stderr fed to syslog (/var/log/messages, tag
 # "nomadnet[<pid>]") through a FIFO, so $! / the pidfile is nomadnet itself.
 # --console: log to stdout (-> syslog) instead of $configdir/logfile on the SD
-# card; --config (not --configdir) is nomadnet's flag.
+# card; --config (not --configdir) is nomadnet's flag. It leads a session and
+# process group of its own (setsid), and stop ends that whole group: nomadnet
+# embeds the same LXMF router as lxmd, whose forked stamp workers outlived a
+# SIGTERM to lxmd alone (see stop_nomadnet), and runs page scripts as child
+# processes. Nothing started here keeps the caller's stdin/stdout/stderr, so
+# `S83nomadnet start | head` returns at once instead of when nomadnet exits.
 
 NAME=nomadnet
 DAEMON=/usr/bin/nomadnet
 CONF=/etc/rnsbox/nomadnet.conf
 PIDFILE=/var/run/$NAME.pid
 LOGPIPE=/var/run/$NAME.logpipe
+LOGGER_PIDFILE=/var/run/$NAME.logger.pid   # the logger reading $LOGPIPE
 DEFAULT_CONFIGDIR=/var/lib/nomadnetwork
 PERMS_MARK=/run/nomadnet-perms-done   # configdir whose full walk ran this boot
 DEPS_MARK=/run/wanwatch-deps-pending  # S46wanwatch starts us once rnsd's up
+STOP_WAIT=10   # s nomadnet gets to persist its state and exit after SIGTERM
 
 # Not installed: nothing to run (and `enabled` answers no).
 if [ ! -x "$DAEMON" ]; then
@@ -67,6 +74,142 @@ rns_shared_up() {
 	return 1
 }
 
+# pidfile_pid FILE — print the pid FILE holds; false if none (or not a pid).
+pidfile_pid() {
+	_p=
+	{ read -r _p <"$1"; } 2>/dev/null
+	case "$_p" in ''|*[!0-9]*) return 1 ;; esac
+	echo "$_p"
+}
+
+# pstat PID — PSTATE and PPGRP = PID's state and process group (fields 3 and
+# 5 of /proc/PID/stat, counted after comm's last ")": comm may hold spaces);
+# false once PID is gone. Builtins only. Same as S82rnsd/S85lxmd.
+pstat() {
+	PSTATE=; PPGRP=
+	case "$1" in ''|*[!0-9]*) return 1 ;; esac
+	_s=
+	{ read -r _s <"/proc/$1/stat"; } 2>/dev/null || return 1
+	set -- ${_s##*) }
+	PSTATE=$1; PPGRP=$3
+}
+
+# is_nomadnet PID — true if PID is a live nomadnet, or a fork of one (LXMF's
+# stamp workers are forks without exec, so they keep its comm). nomadnet is a
+# python console-script and the kernel names a script process after the
+# script file, so its comm is "nomadnet"; started through the interpreter
+# instead (comm python*) it is confirmed on argv[0]/argv[1]. A zombie, a
+# recycled pid or logger's "nomadnet[<pid>]" tag never match.
+is_nomadnet() {
+	pstat "$1" && [ "$PSTATE" != Z ] || return 1
+	comm=
+	{ read -r comm <"/proc/$1/comm"; } 2>/dev/null
+	case "$comm" in
+		nomadnet) return 0 ;;
+		python*)  tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | head -n 2 \
+		            | grep -qE '(^|/)nomadnet$' ;;
+		*)        return 1 ;;
+	esac
+}

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S36wifiwatch b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S36wifiwatch
index 7b7c04796..ceb1e7da4 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S36wifiwatch
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S36wifiwatch
@@ -97,8 +97,12 @@ loop() {
 	done
 }
 
+# `( loop )` with its own stdio, so neither the loop nor what it runs keeps the
+# caller's stdin/stdout/stderr (`S36wifiwatch start | cat` waited forever);
+# wpa_cli's "OK" replies go to /dev/null, errors to $LOG. Not `loop ... &`:
+# ash would keep a saved copy of the caller's stdout (see S45ntpsync launch).
 case "${1:-start}" in
-	start) loop & ;;
+	start) ( loop ) </dev/null >/dev/null 2>>"$LOG" & ;;
 	stop)  : ;;
 	*) echo "usage: $0 {start|stop}"; exit 1 ;;
 esac

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
index 98ee97d70..e9c3c28fe 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S30eth
@@ -1,7 +1,8 @@
 #!/bin/sh
-# S30eth — bring up the WAN on eth0 with either a DHCP lease or a static
-# address, per /etc/rnsbox/wan.conf — but ONLY when eth0 is the WAN
-# (interface=eth0, the default).
+# S30eth — bring up eth0 as an uplink with either a DHCP lease or a static
+# address, per /etc/rnsbox/wan.conf — whenever eth0 can be the WAN:
+# interface=auto (the default: eth0 and the wlan0 WiFi client are both
+# uplinks, the kernel prefers eth0 by route metric) or interface=eth0.
 #
 # DHCP path: busybox udhcpc (its default.script sets the lease addr/route and
 #   registers the lease DNS with openresolv as "eth0"). Backgrounded;
@@ -15,14 +16,23 @@
 #   same one dhcpcd feeds for a wlan0 STA — so neither writer's regeneration
 #   drops the other's servers (dnsmasq + the box's own resolver follow it).
 #
+# interface=auto: eth0 is configured as for eth0, and dhcpcd's default route
+#   on a wlan0 STA (metric 3000+) stays behind eth0's (metric 0). Only in
+#   auto (pinned eth0 keeps its old behaviour): eth0's
+#   ignore_routes_with_linkdown (set in start) makes the kernel skip eth0's
+#   routes while its cable is out, so the WiFi client takes over at once
+#   instead of the stale lease blackholing traffic; S46wanwatch drops eth0's
+#   DNS servers then (`linkdown`) and restores them when the link is back
+#   (`renew`, `linkup`), and a static DNS list is registered only while eth0
+#   has carrier (it is exclusive: it would hide the WiFi client's servers).
 # interface=wlan0 (W variant; S35wifi + dhcpcd address wlan0): eth0 is left
 #   unconfigured — no DHCP client, no address, no route. Otherwise a cable in
 #   eth0 would add udhcpc's metric-0 default route and hijack the WiFi WAN.
 #   udhcpc here is eth0's only DHCP client (dhcpcd.conf no longer lists eth0).
 #
 # `restart` (the portal runs it, then S60routing, on every WAN save) always
-# tears eth0 down first, so eth0 <-> wlan0 and dhcp <-> static switches end
-# clean both ways.
+# tears eth0 down first, so auto/eth0 <-> wlan0 and dhcp <-> static switches
+# end clean both ways.
 #
 # /boot/eth.nodhcp still forces "leave eth0 alone" (legacy escape hatch).
 
@@ -41,10 +51,30 @@ cfg() {
 
 wan_iface() {
 	# Same rules as S60routing read_wan(): the interface= key, else a legacy
-	# bare "eth0"/"wlan0" line, else eth0.
+	# bare "eth0"/"wlan0" line, else auto (also for an unknown value).
 	w=$(cfg interface | tr -d '[:space:]')
 	[ -z "$w" ] && w=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$|=' "$WAN_CONF" 2>/dev/null | head -1 | tr -d '[:space:]')
-	case "$w" in eth0|wlan0) echo "$w" ;; *) echo eth0 ;; esac
+	case "$w" in auto|eth0|wlan0) echo "$w" ;; *) echo auto ;; esac
+}
+
+# eth_managed — true when start() configures eth0 at all: no
+# /boot/eth.nodhcp and eth0 can be the WAN (interface=auto or eth0).
+eth_managed() {
+	[ ! -e /boot/eth.nodhcp ] && [ "$(wan_iface)" != wlan0 ]
+}
+
+# eth_auto — eth0 is managed and interface=auto: eth0 is one of two uplinks,
+# so its link state decides whether its routes and DNS servers count.
+eth_auto() {
+	[ ! -e /boot/eth.nodhcp ] && [ "$(wan_iface)" = auto ]
+}
+
+# eth0_carrier — true while eth0 has a link (the file reads EINVAL while
+# eth0 is admin-down).
+eth0_carrier() {
+	c=
+	{ read -r c </sys/class/net/eth0/carrier; } 2>/dev/null
+	[ "$c" = 1 ]
 }
 
 eth0_udhcpc_pids() {
@@ -68,11 +98,10 @@ stop_dhcp() {
 	rm -f /run/udhcpc.eth0.pid
 }
 
-# dhcp_wan — true when start() would run udhcpc: no /boot/eth.nodhcp,
-# interface=eth0, and not static with an address (an empty static address
-# falls back to DHCP).
+# dhcp_wan — true when start() would run udhcpc: eth0 is managed and not
+# static with an address (an empty static address falls back to DHCP).
 dhcp_wan() {
-	[ ! -e /boot/eth.nodhcp ] && [ "$(wan_iface)" = eth0 ] || return 1
+	eth_managed || return 1
 	[ "$(cfg mode)" != static ] || [ -z "$(cfg address)" ]
 }
 
@@ -83,15 +112,44 @@ dhcp_wan() {
 # busybox puts it in the DISCOVER as the requested-IP option, nothing more).
 # The same network re-grants it; another network ignores the hint and offers
 # its own address. Either way the WAN is back after a brief outage; a silent
-# network leaves udhcpc retrying in the background, as at boot. No-op unless
-# eth0 is the DHCP WAN. Nothing for S60routing to redo: the ruleset names
-# ifaces, not addresses.
+# network leaves udhcpc retrying in the background, as at boot. No-op
+# unless eth0 is the DHCP WAN, except with interface=auto: a static eth0
+# kept its address and routes across the unplug, and only gets its DNS
+# servers (which `linkdown` dropped) registered again. Nothing for
+# S60routing to redo: the ruleset names ifaces, not addresses.
 renew() {
-	dhcp_wan || return 0
-	REQUEST_IP=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{sub("/.*", "", $4); print $4; exit}')
-	echo "eth0 renew: restarting udhcpc${REQUEST_IP:+, asking for $REQUEST_IP}"
-	stop
-	start
+	if dhcp_wan; then
+		REQUEST_IP=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{sub("/.*", "", $4); print $4; exit}')
+		echo "eth0 renew: restarting udhcpc${REQUEST_IP:+, asking for $REQUEST_IP}"
+		stop
+		start
+	else
+		linkup
+	fi
+}
+
+# linkup — interface=auto, static eth0 with carrier: register its DNS
+# servers (idempotent; no udhcpc restart). S46wanwatch runs it at its start
+# when eth0 already has a link: at boot start_static usually runs before the
+# link has come up, so it registered nothing, and no carrier-up edge follows.
+linkup() {
+	eth_auto && ! dhcp_wan || return 0
+	eth0_carrier || return 0
+	echo "eth0 link up: registering its static DNS servers"
+	register_static_dns
+}
+
+# linkdown — interface=auto only. S46wanwatch runs this when eth0 loses its
+# carrier (and once at its start if eth0 has none). The kernel already
+# ignores eth0's routes then (ignore_routes_with_linkdown), but its DNS
+# servers would stay in resolv.conf: a static list is registered exclusive
+# and would hide the WiFi client's servers entirely, a DHCP one would leave
+# dnsmasq trying a server that is now unreachable. Drop them; `renew`
+# restores them on re-plug.
+linkdown() {
+	eth_auto || return 0
+	echo "eth0 link down: dropping its DNS servers until the cable is back"
+	strip_resolv
 }
 
 strip_resolv() {
@@ -139,19 +197,29 @@ start_static() {
 		# dhcpcd's wlan0 default (metric 3000+) alone if the STA is also up.
 		ip route replace default via "$gw" dev eth0 2>/dev/null
 	fi
-	# Register the static DNS servers with openresolv as the eth0 entry, so
-	# dnsmasq (upstream) + the box's own resolver use them and a dhcpcd event on
-	# a wlan0 STA (resolvconf -a wlan0.dhcp) can't regenerate them away.
-	# Exclusive: only the operator's servers are listed while this is set.
-	# The touch lets openresolv back up an empty file, not a stale
-	# /etc/resolv.conf.bak from an earlier boot.
-	if [ -n "$dns" ]; then
-		[ -e "$RESOLV" ] || : > "$RESOLV"
-		for s in $dns; do echo "nameserver $s"; done | IF_EXCLUSIVE=yes resolvconf -a eth0
-	fi
+	register_static_dns
 	echo "static $addr/$prefix gw=${gw:-none} dns=${dns:-none}"
 }
 
+# Register the static DNS servers with openresolv as the eth0 entry, so
+# dnsmasq (upstream) + the box's own resolver use them and a dhcpcd event on
+# a wlan0 STA (resolvconf -a wlan0.dhcp) can't regenerate them away.
+# Exclusive: only the operator's servers are listed while this is set. With
+# interface=auto only while eth0 has carrier (linkup/renew register them once
+# the link is up, linkdown drops them), so an unplugged static eth0 can't
+# hide the WiFi client's servers. The touch lets openresolv back up an empty
+# file, not a stale /etc/resolv.conf.bak from an earlier boot.
+register_static_dns() {
+	dns=$(cfg dns)
+	[ -n "$dns" ] || return 0
+	if eth_auto && ! eth0_carrier; then
+		echo "static DNS deferred until eth0 has a link"
+		return 0
+	fi
+	[ -e "$RESOLV" ] || : > "$RESOLV"
+	for s in $dns; do echo "nameserver $s"; done | IF_EXCLUSIVE=yes resolvconf -a eth0
+}
+
 start() {
 	printf "start ethernet: "
 	# openresolv restores /etc/resolv.conf.bak (on the SD rootfs) whenever its
@@ -164,7 +232,16 @@ start() {
 		return
 	fi
 	iface=$(wan_iface)
-	if [ "$iface" != "eth0" ]; then
+	# interface=auto: route lookups skip eth0's routes while it has no
+	# carrier, so an unplugged eth0's lease (or static gateway) can't
+	# outrank the WiFi client's default route. Per interface in the kernel
+	# (IN_DEV_CONF_GET: all.* isn't consulted). Only eth0: br-lan's
+	# connected route must stay when no LAN port is up, and a wlan0 route
+	# already has the highest metric. 0 (the kernel default) otherwise, so
+	# a pinned eth0 behaves as before and a switch away from auto undoes it.
+	v=0; [ "$iface" = auto ] && v=1
+	echo $v > /proc/sys/net/ipv4/conf/eth0/ignore_routes_with_linkdown 2>/dev/null
+	if [ "$iface" = wlan0 ]; then
 		# (stop's strip_resolv already regenerated resolv.conf from dhcpcd's
 		# wlan0 entry when the WAN moved off eth0.)
 		echo "skipped (WAN=$iface — eth0 left unconfigured)"
@@ -186,13 +263,20 @@ stop() {
 	# default route included.
 	ip addr flush dev eth0 2>/dev/null
 	strip_resolv
+	# WAN=auto: flows opened while eth0 is re-addressed go out the WiFi
+	# client; S46wanwatch flushes their NAT entries once eth0 is the uplink
+	# again, even if that happens between two of its ticks.
+	eth_auto && : > /run/wan-eth0-readdressed
 }
 
 case "${1:-start}" in
-	start)   start ;;
-	stop)    stop ;;
-	restart) stop; start ;;        # NB: real order (old S30eth had it backwards)
-	renew)   renew ;;
-	dhcpwan) dhcp_wan ;;           # exit 0 iff eth0 is the DHCP WAN (S46wanwatch)
-	*)       echo "Usage: $0 {start|stop|restart|renew|dhcpwan}" >&2; exit 1 ;;
+	start)    start ;;
+	stop)     stop ;;
+	restart)  stop; start ;;        # NB: real order (old S30eth had it backwards)
+	renew)    renew ;;
+	linkup)   linkup ;;
+	linkdown) linkdown ;;
+	managed)  eth_managed ;;        # exit 0 iff eth0 is configured here (S46wanwatch)
+	auto)     eth_auto ;;           # exit 0 iff also interface=auto (S46wanwatch)
+	*)        echo "Usage: $0 {start|stop|restart|renew|linkup|linkdown|managed|auto}" >&2; exit 1 ;;
 esac

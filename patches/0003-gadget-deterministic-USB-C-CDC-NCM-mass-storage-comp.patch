@@ -130,6 +142,20 @@ then
 		then
 			mkdir -p functions/ncm.usb0
 			ln -s functions/ncm.usb0 configs/c.1/
+
+			# MS-OS-DESC compat-id WINNCM — Windows 10 1709+ and 11 use the
+			# device-supplied compat-id string to auto-bind their in-box
+			# usbncm.sys driver without showing "Unknown USB Device". The
+			# literal string is "WINNCM", not "NCM" (an MS-OS-descriptor gotcha;

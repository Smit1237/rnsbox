+# Stock Sipeed shipped: usb.dev usb.ncm usb.rndis wifi.sta gt9xx logo.jpeg.
+# Removed: usb.rndis (NCM-only, Luckfox lesson #13), wifi.sta (-e has no
+# WiFi), gt9xx (no touchpad), logo.jpeg (no display, CONFIG_FB=n).
+# usb.disk0 → the read-only ISO9660 "DVD" of Reticulum clients (usbdisk.iso).
+
 image boot.vfat {
         vfat {
                 label = "boot"
                 files = {
                         "fip.bin",
                         "rawimages/boot.sd",
-			"usb.dev",
-			"usb.ncm",
-                        "usb.rndis",
-			"wifi.sta",
-			"gt9xx",
-			"logo.jpeg",
-			"ver",
+                        "usb.dev",
+                        "usb.ncm",
+                        "usb.disk0",
+                        "usb.disk0.size",
+                        "usb.idVendor",
+                        "usb.idProduct",
+                        "usb.bcdDevice",
+                        "usb.manufacturer",
+                        "usb.product",
+                        "hostname",
+                        "ver",
                 }
         }
-        size = 16M 
+        size = 16M
 }
 
 image duo.img {
@@ -31,4 +42,3 @@ image duo.img {

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S09ipv6 b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S09ipv6
new file mode 100755
index 000000000..4182112e1
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S09ipv6
@@ -0,0 +1,50 @@
+#!/bin/sh
+# S09ipv6 — confine IPv6 to the USB LAN (usb0) before any other iface is up.
+#
+# IPv6 is compiled into the kernel for ONE consumer: Reticulum's AutoInterface
+# on usb0 (/etc/reticulum/config). It needs a fe80:: link-local address on
+# usb0 and joins an ff12:: link-scope multicast group (UDP 29716 multicast
+# discovery, 29717 unicast discovery, 42671 data). Nothing else on the box
+# uses IPv6, so every other iface — eth0, wlan0, wlan1, sl0, a USB dongle —
+# stays IPv4-only and never gets a link-local/SLAAC address a WAN peer could
+# reach. (nftgen's ip6 table is the second layer: drop unless LAN.)
+#
+# Order matters. This runs after S08usbdev (usb0 may or may not exist yet) and
+# before S10uuid (the first `ifconfig eth0 up`), S30eth, S31slip (creates sl0)
+# and S35wifi (creates wlan0/wlan1):
+#   1. conf/default/disable_ipv6=1 — every iface registered from now on starts
+#      with IPv6 off (also one that only gets IPv6 later, when its MTU is
+#      raised to >= 1280, e.g. sl0).
+#   2. every iface that already exists, except lo and usb0, is switched off
+#      now (in practice eth0, registered by its driver at kernel boot).
+#   3. usb0 is opted back in by S30gadget_nic just before it raises usb0 (it
+#      may be created after this runs and so inherit default=1).
+# conf/all/disable_ipv6 is deliberately NOT written: on 5.10 that pushes the
+# value to every existing iface, lo and usb0 included.
+# The IPv4 counterpart is S29fw: it loads a fail-closed nftables ruleset (lo +
+# usb0 only) before S30eth/S35wifi address the WAN, until S60routing's real one.
+#
+# A kernel without IPv6 has no /proc/sys/net/ipv6 — then this is a no-op.
+
+LAN_V6="lo usb0"   # the only ifaces allowed to keep IPv6
+
+start() {
+	if [ ! -d /proc/sys/net/ipv6/conf ]; then
+		echo "S09ipv6: kernel has no IPv6; nothing to do"
+		return 0
+	fi
+	echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
+	for d in /proc/sys/net/ipv6/conf/*; do
+		ifc=${d##*/}
+		case " all default $LAN_V6 " in *" $ifc "*) continue ;; esac
+		echo 1 > "$d/disable_ipv6" 2>/dev/null
+	done
+	echo 0 > /proc/sys/net/ipv6/conf/lo/disable_ipv6 2>/dev/null
+	echo "S09ipv6: IPv6 off by default; kept only on: $LAN_V6"
+}
+
+case "${1:-start}" in
+	start|restart) start ;;
+	stop)          ;;    # nothing to undo; the policy must hold until power-off
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac

+			# bcdDevice must be bumped any time the gadget topology changes —
+			# we pin it via /boot/usb.bcdDevice (set during image build).
+			echo 1       > os_desc/use
+			echo 0xcd    > os_desc/b_vendor_code
+			echo MSFT100 > os_desc/qw_sign

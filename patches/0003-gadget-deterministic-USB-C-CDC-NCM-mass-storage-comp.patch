+	# unit: usb0's EUI-64 fe80:: is how RNS AutoInterface tells boxes apart.
+	key=$(cat /device_key 2>/dev/null)
+	if [ -e /boot/usb.ncm.mac ]; then
+		new_mac=$(cat /boot/usb.ncm.mac)
+	elif [ -n "$key" ]; then

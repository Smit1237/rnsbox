diff --git a/linux_5.10/drivers/usb/gadget/function/f_ncm.c b/linux_5.10/drivers/usb/gadget/function/f_ncm.c
index 019bea8e0..7c464a927 100644
--- a/linux_5.10/drivers/usb/gadget/function/f_ncm.c
+++ b/linux_5.10/drivers/usb/gadget/function/f_ncm.c
@@ -1101,11 +1101,24 @@ static struct sk_buff *ncm_wrap_ntb(struct gether *port,
 			ncm->ndp_dgram_count = 1;
 
 			/* Note: we skip opts->next_ndp_index */
-		}
 
-		/* Delay the timer. */
-		hrtimer_start(&ncm->task_timer, TX_TIMEOUT_NSECS,
-			      HRTIMER_MODE_REL_SOFT);
+			/* Start the timer.
+			 *
+			 * RNSBox: moved this inside
+			 * the new-NDP block. Original upstream code restarts
+			 * the hrtimer on EVERY datagram. Under sustained load
+			 * (>3-4k pkt/s),
+			 * each packet kept pushing the timer forward, so the
+			 * NTB only flushed when it hit dwNtbInMaxSize (16KB).
+			 * That stalled small flows (interactive TCP, ACKs) for
+			 * milliseconds and starved the host side of usable NCM
+			 * NTBs, hard-capping tunnel throughput at ~25 Mbps on
+			 * a 1 GHz core. Bounding the NTB age at TX_TIMEOUT_NSECS
+			 * after the FIRST datagram of an NDP fixes both.
+			 */
+			hrtimer_start(&ncm->task_timer, TX_TIMEOUT_NSECS,
+				      HRTIMER_MODE_REL_SOFT);
+		}
 
 		/* Add the datagram position entries */
 		ntb_ndp = skb_put_zero(ncm->skb_tx_ndp, dgram_idx_len);

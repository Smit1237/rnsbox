From c660ff35f4ba1d6174dc4114a97181392058925e Mon Sep 17 00:00:00 2001
From: smit1237 <smit1237@gmail.com>
Date: Tue, 8 Sep 2026 22:47:48 +0300
Subject: [PATCH 03/21] gadget: deterministic USB-C CDC-NCM (+ mass-storage)
 composite

Bring the USB-C gadget up as CDC-NCM with a fixed usb0 = 10.42.0.1/24 (dnsmasq
owns DHCP; no udhcpd), a Windows MS-OS descriptor compat-id so usbncm.sys
auto-binds, and a pinned device identity. S08usbdev also composes an optional
read-only mass-storage LUN backed by the clients ISO. Carry an f_ncm TX-timer
fix that arms the NTB flush hrtimer once per NTB instead of per datagram,
removing a small-flow throughput stall under sustained load. genimage/sd_gen
ship the gadget descriptor flag files on the boot FAT.
---
 .../common/sd_tools/genimage_rootless.cfg     |  29 ++-
 .../sd_tools/sd_gen_burn_image_rootless.sh    |  40 +++-
 .../SG200X/overlay/etc/init.d/S08usbdev       |  65 ++++--
 .../SG200X/overlay/etc/init.d/S30gadget_nic   | 201 ++++--------------
 .../drivers/usb/gadget/function/f_ncm.c       |  21 +-
 5 files changed, 167 insertions(+), 189 deletions(-)

diff --git a/build/tools/common/sd_tools/genimage_rootless.cfg b/build/tools/common/sd_tools/genimage_rootless.cfg
index af447e3eb..31188ae35 100644
--- a/build/tools/common/sd_tools/genimage_rootless.cfg
+++ b/build/tools/common/sd_tools/genimage_rootless.cfg
@@ -1,19 +1,31 @@
+# RNSBox: composite CDC-NCM + USB mass-storage gadget. /boot has the usb.*
+# flag files + descriptor strings that S08usbdev reads to compose the gadget.
+# Stock Sipeed shipped: usb.dev usb.ncm usb.rndis wifi.sta gt9xx logo.jpeg.
+# Removed: usb.rndis (NCM-only, Luckfox lesson #13), wifi.sta (-e has no
+# WiFi), gt9xx (no touchpad), logo.jpeg (no display, CONFIG_FB=n).
+# usb.disk0 → the read-only ISO9660 "DVD" of Reticulum clients (usbdisk.iso).
+
 image boot.vfat {
         vfat {
                 label = "boot"
                 files = {
                         "fip.bin",
                         "rawimages/boot.sd",
-			"usb.dev",
-			"usb.ncm",
-                        "usb.rndis",
-			"wifi.sta",
-			"gt9xx",
-			"logo.jpeg",
-			"ver",
+                        "usb.dev",
+                        "usb.ncm",
+                        "usb.ncm.mac",
+                        "usb.disk0",
+                        "usb.disk0.size",
+                        "usb.idVendor",
+                        "usb.idProduct",
+                        "usb.bcdDevice",
+                        "usb.manufacturer",
+                        "usb.product",
+                        "hostname",
+                        "ver",
                 }
         }
-        size = 16M 
+        size = 16M
 }
 
 image duo.img {
@@ -31,4 +43,3 @@ image duo.img {
                 image = "rootfs.sd"
         }
 }
-
diff --git a/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh b/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
index bfce61c3b..02f5e5573 100755
--- a/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
+++ b/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
@@ -26,15 +26,45 @@ mkdir -pv ${output_dir}/input/rawimages/
 cp -fv ${output_dir}/fip.bin ${output_dir}/input/
 cp -fv ${output_dir}/rawimages/boot.sd ${output_dir}/input/rawimages/
 cp -fv ${output_dir}/rawimages/rootfs.sd ${output_dir}/input/
+# RNSBox: CDC-NCM gadget. DVD variant also adds the read-only mass-storage
+# function (usb.disk0 → the clients ISO). LITE variant ships NCM-only.
+# Controlled by RNSBOX_WITH_DVD (default 1 = DVD); the build scripts export it.
 touch ${output_dir}/input/usb.dev
 touch ${output_dir}/input/usb.ncm
-touch ${output_dir}/input/usb.rndis
-touch ${output_dir}/input/wifi.sta
-touch ${output_dir}/input/gt9xx
-touch ${output_dir}/input/fb
+if [ "${RNSBOX_WITH_DVD:-1}" = "1" ]; then
+	# usb.disk0 (empty value) → S08usbdev attaches the read-only clients ISO
+	# at /opt/rnsbox-clients/usbdisk.iso as an emulated DVD.
+	touch ${output_dir}/input/usb.disk0
+	echo "iso" > ${output_dir}/input/usb.disk0.size
+else
+	# LITE: NCM-only — do not ship usb.disk0, so S08usbdev's mass-storage
+	# branch (gated on /boot/usb.disk0) is skipped entirely.
+	rm -f ${output_dir}/input/usb.disk0 ${output_dir}/input/usb.disk0.size
+fi
+# Empty flags removed: usb.rndis (NCM-only, Luckfox lesson #13),
+# wifi.sta, gt9xx, fb. They each trigger S08usbdev / S30wifi / S04fb
+# branches we don't ship.
+
+# USB descriptor strings — S08usbdev reads these flag files at boot.
+# Windows caches MS_OS_DESC by (VID, PID, bcdDevice) so don't reuse a stale
+# bcdDevice when changing the gadget topology (Luckfox lesson #15, #33).
+# RNSBox: bcdDevice bumped 0x0104 → 0x0105 because adding the mass-storage
+# function changes the gadget topology — a stale Windows MS_OS_DESC cache
+# keyed on the old (VID,PID,bcdDevice) would otherwise mis-enumerate it.
+echo 0x1d6b > ${output_dir}/input/usb.idVendor
+echo 0x0105 > ${output_dir}/input/usb.idProduct
+echo 0x0105 > ${output_dir}/input/usb.bcdDevice
+echo "RNSBox" > ${output_dir}/input/usb.manufacturer
+echo "RNSBox Reticulum router (LicheeRV Nano-e)" > ${output_dir}/input/usb.product
+# Pin the device-side NCM MAC so host-side `enxXXXX` ifname is deterministic.
+echo "02:1d:6b:01:04:02" > ${output_dir}/input/usb.ncm.mac
+# Override the auto-generated `licheervnano-<keyhash>` hostname (S10uuid
+# reads /boot/hostname if present and overrides /etc/hostname with it).
+echo "rnsbox" > ${output_dir}/input/hostname
+
 echo ${image} > ${output_dir}/input/ver
 cp -fv ${THISDIR}/genimage_rootless.cfg ${output_dir}/genimage.cfg
-cp -fv ${THISDIR}/logo.jpeg ${output_dir}/input/logo.jpeg
+# No boot logo — display drivers are disabled. logo.jpeg copy removed.
 sed -i -e "s/duo.img/${image}/g" ${output_dir}/genimage.cfg
 cd ${output_dir}/
 ${THISDIR}/genimage

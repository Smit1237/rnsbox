+				echo 1 > functions/mass_storage.disk0/lun.0/ro
+				echo 1 > functions/mass_storage.disk0/lun.0/cdrom
+				ln -s functions/mass_storage.disk0 configs/c.1/
+				echo "${IMG}" > functions/mass_storage.disk0/lun.0/file
 			else
-				cat /boot/usb.disk0 > functions/mass_storage.disk0/lun.0/file
+				echo "usb.disk0: backing image ${IMG} not found — skipping mass storage"
 			fi
 		fi
 
@@ -129,7 +141,50 @@ then
 		if [ -e /boot/usb.ncm ]
 		then
 			mkdir -p functions/ncm.usb0
+
+			# Host-side MAC. host_addr is what the host's NIC gets (so it
+			# names Linux's `enxXXXX` iface and keys Windows' network
+			# profile); left unset, the kernel picks a random one every boot.
+			# Default: a locally-administered unicast MAC derived from
+			# /device_key (S02devicekey), so it is stable per unit and two
+			# boxes on one host don't collide. /boot/usb.ncm.host_mac
+			# overrides it. (The device-side MAC is set on usb0 by
+			# S30gadget_nic, also per unit; /boot/usb.ncm.mac, if present,
+			# overrides it.) Must be set before the UDC
+			# bind below.
+			key=$(cat /device_key 2>/dev/null)
+			if [ -e /boot/usb.ncm.host_mac ]
+			then
+				host_mac=$(cat /boot/usb.ncm.host_mac)
+			elif [ -n "${key}" ]
+			then
+				h=$(printf 'ncm-host:%s' "${key}" | sha256sum | cut -c1-12)
+				b0=$(( (0x$(echo "$h" | cut -c1-2) & 0xfc) | 0x02 ))

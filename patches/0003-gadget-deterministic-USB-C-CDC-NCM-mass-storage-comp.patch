diff --git a/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh b/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
index bfce61c3b..1f85d2b00 100755
--- a/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
+++ b/build/tools/common/sd_tools/sd_gen_burn_image_rootless.sh
@@ -26,15 +26,53 @@ mkdir -pv ${output_dir}/input/rawimages/
 cp -fv ${output_dir}/fip.bin ${output_dir}/input/
 cp -fv ${output_dir}/rawimages/boot.sd ${output_dir}/input/rawimages/
 cp -fv ${output_dir}/rawimages/rootfs.sd ${output_dir}/input/
+# RNSBox: CDC-NCM gadget. DVD variant also adds the read-only mass-storage
+# function (usb.disk0 → the clients ISO). LITE variant ships NCM-only.
+# Controlled by RNSBOX_WITH_DVD (default 1 = DVD); the build scripts export it.
 touch ${output_dir}/input/usb.dev
 touch ${output_dir}/input/usb.ncm
-touch ${output_dir}/input/usb.rndis
-touch ${output_dir}/input/wifi.sta
-touch ${output_dir}/input/gt9xx
-touch ${output_dir}/input/fb
+if [ "${RNSBOX_WITH_DVD:-1}" = "1" ]; then
+	# usb.disk0 (empty value) → S08usbdev attaches the read-only clients ISO
+	# at /opt/rnsbox-clients/usbdisk.iso as an emulated DVD.
+	touch ${output_dir}/input/usb.disk0
+	echo "iso" > ${output_dir}/input/usb.disk0.size
+else
+	# LITE: NCM-only — do not ship usb.disk0, so S08usbdev's mass-storage
+	# branch (gated on /boot/usb.disk0) is skipped entirely.
+	rm -f ${output_dir}/input/usb.disk0 ${output_dir}/input/usb.disk0.size
+fi
+# Empty flags removed: usb.rndis (NCM-only, Luckfox lesson #13),
+# wifi.sta, gt9xx, fb. They each trigger S08usbdev / S30wifi / S04fb
+# branches we don't ship.
+
+# USB descriptor strings — S08usbdev reads these flag files at boot.
+# Windows caches MS_OS_DESC by (VID, PID, bcdDevice) so don't reuse a stale
+# bcdDevice when changing the gadget topology (Luckfox lesson #15, #33).
+# RNSBox: bcdDevice bumped 0x0104 → 0x0105 because adding the mass-storage
+# function changes the gadget topology — a stale Windows MS_OS_DESC cache
+# keyed on the old (VID,PID,bcdDevice) would otherwise mis-enumerate it.
+echo 0x1d6b > ${output_dir}/input/usb.idVendor
+echo 0x0105 > ${output_dir}/input/usb.idProduct
+echo 0x0105 > ${output_dir}/input/usb.bcdDevice
+echo "RNSBox" > ${output_dir}/input/usb.manufacturer
+echo "RNSBox Reticulum router (LicheeRV Nano-e)" > ${output_dir}/input/usb.product
+# No fixed device-side NCM MAC: S30gadget_nic derives the box's own usb0 MAC
+# per unit from /device_key. It is also the source of usb0's fe80:: address,
+# which is how Reticulum's AutoInterface tells boxes apart, so it must differ
+# per unit (one MAC for every box made two boxes on one host a single peer).
+# /boot/usb.ncm.mac is an optional override and is not shipped; the input dir
+# survives between builds, so remove an old copy explicitly.
+# The host-side MAC — and so the host's `enxXXXX` ifname — is the gadget's ncm
+# host_addr, which S08usbdev also derives per unit from /device_key (optional
+# override: /boot/usb.ncm.host_mac, not shipped).
+rm -f ${output_dir}/input/usb.ncm.mac
+# Override the auto-generated `licheervnano-<keyhash>` hostname (S10uuid
+# reads /boot/hostname if present and overrides /etc/hostname with it).
+echo "rnsbox" > ${output_dir}/input/hostname
+
 echo ${image} > ${output_dir}/input/ver
 cp -fv ${THISDIR}/genimage_rootless.cfg ${output_dir}/genimage.cfg
-cp -fv ${THISDIR}/logo.jpeg ${output_dir}/input/logo.jpeg
+# No boot logo — display drivers are disabled. logo.jpeg copy removed.
 sed -i -e "s/duo.img/${image}/g" ${output_dir}/genimage.cfg
 cd ${output_dir}/
 ${THISDIR}/genimage
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S02devicekey b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S02devicekey
index 9d55fb43b..cbca43260 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S02devicekey
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S02devicekey
@@ -1,13 +1,96 @@
 #!/bin/sh
+# S02devicekey — per-unit device key, written to
+#   /device_key         16 lowercase hex chars. S08usbdev uses it as the USB
+#                       serial number and to derive the host-side NCM MAC.
+#   /device_key_legacy  "UID: xxxxxxxx_yyyyyyyy". S10uuid (hostname suffix,
+#                       eth0 MAC) and S30gadget_nic sha512sum it.
+#
+# Stock Sipeed only reads the chip UID from /sys/class/cvi-base/base_uid,
+# which exists only while osdrv's soph_base.ko is loaded. RNSBox doesn't build
+# that module (camera/codec middleware stripped), so both files came out
+# empty: every unit got the same eth0 MAC (48:da:35:6f:cf:83, from sha512 of
+# an empty file) and an empty USB serial. Sources, first hit wins — each one
+# per-unit and stable across reboots:
+#   1. base_uid, if a build loads soph_base.ko (files identical to stock)
+#   2. the SD card's CID (+ serial): unique per card, survives a reflash
+#   3. wlan0's burned-in MAC (only if the WiFi driver is already up)
+#   4. a random id generated once and kept in /etc/rnsbox/device-id
+# The chip UID is NOT read with devmem: base.c gets it from the efuse shadow
+# registers via cvi_efuse_read_from_shadow(), which switches clk_efuse on
+# around the read. Linux gates that clock once boot is done, and reading a
+# gated APB block (or poking the shared clock-enable register) from userspace
+# is not something to ship untested.
+
+UID_SYS=/sys/class/cvi-base/base_uid
+ID_FILE=/etc/rnsbox/device-id
+
+# 16 lowercase hex chars from arbitrary text
+hash16() {
+	printf '%s' "$1" | sha256sum | cut -c1-16
+}
+
+# write $2 (+ newline) to $1 unless it already holds it — spares an SD write
+# on every boot
+put() {
+	[ "$(cat "$1" 2>/dev/null)" = "$2" ] || echo "$2" > "$1"
+}
 
 if [ "$1" = "start" ]
 then
-	str_value=$(cat /sys/class/cvi-base/base_uid | awk '{print $2}')
-	first_uint=$(echo $str_value | cut -d'_' -f1)
-	second_uint=$(echo $str_value | cut -d'_' -f2)
-	result="$first_uint$second_uint"
-	echo $result > /device_key
+	key=""
+	legacy=""
+	src=""
+
+	# 1. chip UID, stock format "UID: xxxxxxxx_yyyyyyyy" (all-zero = unfused)
+	uid=$(cat "$UID_SYS" 2>/dev/null)
+	str_value=$(echo "$uid" | awk '{print $2}')
+	case "$str_value" in
+		*[1-9a-f]*_*|*_*[1-9a-f]*)
+			key="${str_value%%_*}${str_value#*_}"
+			legacy="$uid"
+			src="chip UID"
+			;;
+	esac
+
+	# 2. SD card CID (skip blank IDs: some counterfeit cards report all 0/F)
+	if [ -z "$key" ]; then
+		for d in /sys/block/mmcblk*/device; do
+			cid=$(cat "$d/cid" 2>/dev/null)
+			case "$cid" in *[1-9a-eA-E]*) ;; *) continue ;; esac
+			key=$(hash16 "sd:$cid:$(cat "$d/serial" 2>/dev/null)")
+			src="SD card CID (${d%/device})"
+			break
+		done
+	fi
+
+	# 3. wlan0 MAC, only if burned-in (addr_assign_type 0), not software-set
+	if [ -z "$key" ] && [ "$(cat /sys/class/net/wlan0/addr_assign_type 2>/dev/null)" = 0 ]; then
+		mac=$(cat /sys/class/net/wlan0/address 2>/dev/null)
+		case "$mac" in
+			''|00:00:00:00:00:00) ;;
+			*) key=$(hash16 "wlan0:$mac"); src="wlan0 MAC" ;;
+		esac
+	fi
+
+	# 4. random id, generated on first boot and kept on the rootfs
+	if [ -z "$key" ]; then
+		key=$(cat "$ID_FILE" 2>/dev/null)
+		case "$key" in
+			*[!0-9a-f]*) key="" ;;
+			????????????????) ;;
+			*) key="" ;;
+		esac
+		if [ -z "$key" ]; then
+			key=$( { cat /proc/sys/kernel/random/uuid; head -c 16 /dev/urandom; } \
+				2>/dev/null | sha256sum | cut -c1-16)
+			echo "$key" > "$ID_FILE" 2>/dev/null
+		fi
+		src="random id ($ID_FILE)"
+	fi
+
+	[ -n "$legacy" ] || legacy="UID: ${key%????????}_${key#????????}"
+	put /device_key "$key"
 	# for compatibility with previous network mac addr
-	cat /sys/class/cvi-base/base_uid > /device_key_legacy
+	put /device_key_legacy "$legacy"
+	echo "device key: from $src"
 fi
-

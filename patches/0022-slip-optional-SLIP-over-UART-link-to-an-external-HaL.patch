+    def _modem_request(path, method="GET", body=None, ctype=None, query=""):
+        url = _modem_base() + path
+        if query:
+            url += "?" + query
+        headers = {"Accept-Encoding": "identity"}
+        if ctype:
+            headers["Content-Type"] = ctype
+        req = urllib.request.Request(url, data=body, method=method, headers=headers)
+        with urllib.request.urlopen(req, timeout=MODEM_TIMEOUT) as resp:
+            data = resp.read()
+            if "gzip" in (resp.headers.get("Content-Encoding") or "").lower():
+                data = gzip.decompress(data)
+            return data, resp.headers.get("Content-Type", "application/octet-stream")

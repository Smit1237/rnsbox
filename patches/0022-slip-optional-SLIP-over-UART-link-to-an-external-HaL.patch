+// routes_reticulum.cpp — Reticulum tab: server-rendered page + PRG forms +
+// AJAX JSON endpoints (rnsd status / live HaLow modem). Faithful port of the
+// old Flask reticulum() view + its POST/AJAX routes.
+#include "routes.h"
+#include "render.h"
+#include "web.h"

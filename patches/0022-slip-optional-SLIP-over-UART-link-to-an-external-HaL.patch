diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S31slip b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S31slip
new file mode 100755
index 000000000..6f220d562
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S31slip
@@ -0,0 +1,81 @@
+#!/bin/sh
+# S31slip - optional SLIP-over-UART link to an external WiFi-HaLow (RNode)
+# modem. Reads /etc/rnsbox/slip.conf; when enabled, attaches the SLIP line
+# discipline to the configured UART (ldattach) and brings up a point-to-point
+# sl0 interface to the modem. rnsd then reaches the modem as a normal
+# Reticulum interface via a TCPClientInterface to peer_ip:4242 (added to
+# /etc/reticulum/config by the operator).
+#
+# OFF by default. Harmless no-op when disabled, when the UART device is
+# absent, or when the modem simply isn't wired (sl0 just never comes up).
+
+CONF=/etc/rnsbox/slip.conf
+LOG=/var/log/slip.log
+
+# read one key=value from the conf (single value, no shell sourcing)
+cfg() {
+	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null \
+	  | tail -1 | tr -d '"' | tr -d "'" | awk '{print $1}'
+}
+
+start() {
+	[ -r "$CONF" ] || { echo "S31slip: no $CONF; skipping"; return 0; }
+	enabled=$(cfg enabled)
+	case "$enabled" in yes|true|1|on) ;; *) echo "S31slip: disabled"; return 0 ;; esac
+
+	device=$(cfg device);     [ -n "$device" ]   || device=/dev/ttyS1
+	baud=$(cfg baud);         [ -n "$baud" ]     || baud=1500000
+	local_ip=$(cfg local_ip); [ -n "$local_ip" ] || local_ip=192.168.7.1
+	peer_ip=$(cfg peer_ip);   [ -n "$peer_ip" ]  || peer_ip=192.168.7.2
+
+	if [ ! -e "$device" ]; then
+		echo "S31slip: $device not present; skipping"
+		return 1
+	fi
+
+	printf "Starting SLIP (%s @ %s baud) -> sl0: " "$device" "$baud"
+	# Set the line speed with busybox stty (it maps a decimal baud to the right
+	# Bxxxx constant). util-linux ldattach's own `-s <baud>` can NOT do this on
+	# a musl target - musl's cfsetspeed rejects a raw decimal and ldattach's
+	# BOTHER fallback is compiled out - so we set the speed here and attach
+	# without -s. ldattach's cfmakeraw preserves the speed bits.
+	if ! stty -F "$device" "$baud" raw -echo >>"$LOG" 2>&1; then
+		echo "FAIL (stty could not set $baud on $device; see $LOG)"
+		return 1
+	fi
+	# ldattach daemonizes and holds the tty open, keeping N_SLIP loaded so the
+	# kernel slip driver's sl0 netdev stays registered.
+	ldattach SLIP "$device" >>"$LOG" 2>&1
+
+	i=0
+	while [ $i -lt 20 ]; do
+		ip link show sl0 >/dev/null 2>&1 && break
+		i=$((i + 1)); sleep 0.2
+	done
+	if ! ip link show sl0 >/dev/null 2>&1; then
+		echo "FAIL (sl0 not created)"
+		killall ldattach 2>/dev/null
+		return 1
+	fi
+
+	# point-to-point: our end = local_ip, the modem = peer_ip. A host route to
+	# peer_ip goes out sl0; nothing else is affected (no default route change).
+	ip addr flush dev sl0 2>/dev/null
+	ip addr add "$local_ip" peer "$peer_ip" dev sl0 2>/dev/null
+	ip link set sl0 up 2>/dev/null
+	echo "OK ($local_ip -> $peer_ip)"
+}
+
+stop() {
+	killall ldattach 2>/dev/null
+	ip link set sl0 down 2>/dev/null
+	ip addr flush dev sl0 2>/dev/null
+	echo "S31slip: stopped"
+}
+
+case "${1:-start}" in
+	start)          start ;;
+	stop)           stop ;;
+	restart|reload) stop; sleep 1; start ;;
+	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
+esac

+<section class="card">
+  <h3>HaLow modem (SLIP)</h3>
+  <p class="muted">Optional point-to-point serial link (<code>sl0</code>) to an external
+  WiFi-HaLow RNode modem over a UART. When it's up, add a <code>TCPClientInterface</code>
+  to the modem (peer address, port 4242) in the config editor below to use it as a
+  Reticulum interface. Off by default.</p>
+
+  <table class="kv">
+    <tr><th>Link (sl0)</th><td>
+      {% if slip_status.up %}<span class="badge ok">UP</span> {{ slip.local_ip }} &rarr; {{ slip.peer_ip }}
+      {% elif slip_status.present %}<span class="badge warn">DOWN</span> (attached, no address)
+      {% elif slip.enabled_bool %}<span class="badge warn">not attached</span> (modem wired?)
+      {% else %}<span class="badge">disabled</span>{% endif %}
+    </td></tr>
+  </table>
+
+  {% if slip.enabled_bool %}
+  <p style="margin:10px 0 0">
+    <a class="btn" href="{{ url_for('modem_ui') }}" target="_blank" rel="noopener">Open modem web UI &rarr;</a>
+    <span class="muted">the modem's own config page, proxied through this portal login</span>
+  </p>
+  {% endif %}
+
+  <form method="post" action="{{ url_for('reticulum_slip') }}">
+    <label style="margin:8px 0 0"><input type="checkbox" name="enabled"

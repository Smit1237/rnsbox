+# ---- SLIP link to an external HaLow (RNode) modem ----
+
+def read_slip_conf():
+    """slip.conf as a dict, with defaults filled in (+ enabled_bool)."""
+    d = {"enabled": "no", "device": "/dev/ttyS1", "baud": "1500000",
+         "local_ip": "192.168.7.1", "peer_ip": "192.168.7.2"}
+    for ln in _read_lines(SLIP_FILE):
+        s = ln.strip()
+        if s.startswith("#") or "=" not in s:
+            continue
+        k, _, v = s.partition("=")
+        k = k.strip()
+        if k in d:
+            d[k] = v.split("#", 1)[0].strip()
+    d["enabled_bool"] = _truthy(d["enabled"])
+    return d
+
+
+def _valid_tty(s):
+    # reject the serial console: attaching SLIP to it kills the console/login.
+    if s in ("/dev/ttyS0", "/dev/console"):
+        return False
+    return (s.startswith("/dev/") and len(s) <= 64
+            and all(c.isalnum() or c in "/_-" for c in s))
+
+
+def write_slip_conf(d):
+    """Rewrite slip.conf from a dict (validated). Returns (ok, error)."""
+    enabled = "yes" if _truthy(d.get("enabled", "no")) else "no"
+    device = (d.get("device") or "/dev/ttyS1").strip()
+    if not _valid_tty(device):
+        return False, "bad device path"
+    try:
+        baud = int(d.get("baud", 1500000))
+    except (TypeError, ValueError):
+        return False, "baud must be a number"
+    if not (1 <= baud <= 4000000):
+        return False, "baud out of range (1-4000000)"
+    local_ip = (d.get("local_ip") or "192.168.7.1").strip()
+    peer_ip = (d.get("peer_ip") or "192.168.7.2").strip()
+    if not (_valid_ipv4(local_ip) and _valid_ipv4(peer_ip)):
+        return False, "bad IP address"
+    _write_lines(SLIP_FILE, [
+        "# SLIP-over-UART link to an external WiFi-HaLow (RNode) modem.",

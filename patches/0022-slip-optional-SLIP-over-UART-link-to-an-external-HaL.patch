+def slip_status():
+    """Status of the sl0 SLIP interface: present + up (best-effort). SLIP has
+    no carrier, so when brought up it reports 'unknown' rather than 'up'."""
+    if not os.path.isdir("/sys/class/net/sl0"):
+        return {"present": False, "up": False}
+    state = _slurp("/sys/class/net/sl0/operstate").strip()
+    return {"present": True, "up": state not in ("down", "")}

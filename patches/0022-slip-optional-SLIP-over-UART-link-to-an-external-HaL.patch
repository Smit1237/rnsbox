+      <label style="margin:0">Baud
+        <input type="number" name="baud" value="{{ slip.baud }}" min="1" max="4000000"></label>
+      <label style="margin:0">This box (local IP)
+        <input type="text" name="local_ip" value="{{ slip.local_ip }}"></label>
+      <label style="margin:0">Modem (peer IP)
+        <input type="text" name="peer_ip" value="{{ slip.peer_ip }}"></label>
+    </div>
+    <button type="submit" class="btn-primary" style="margin-top:10px">Save &amp; apply</button>
+    <p class="muted">Wire UART1 (<code>GPIOA28</code> TX / <code>A29</code> RX, 3.3&nbsp;V) to the modem,
+    cross TX&harr;RX, common ground &mdash; device <code>/dev/ttyS1</code> (not <code>ttyS0</code>, the console).

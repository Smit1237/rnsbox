+    @app.route("/modem/api/<path:endpoint>", methods=["GET", "POST"])
+    @login_required
+    def modem_api(endpoint):
+        body = request.get_data() if request.method == "POST" else None
+        ctype = request.headers.get("Content-Type") if body else None
+        query = request.query_string.decode("latin-1") if request.query_string else ""
+        try:
+            data, rct = _modem_request(
+                "/api/" + endpoint, method=request.method,
+                body=body, ctype=ctype, query=query)
+        except urllib.error.HTTPError as exc:
+            return Response(
+                exc.read(), status=exc.code,
+                mimetype=exc.headers.get("Content-Type", "application/json"))
+        except Exception:  # noqa: BLE001 - modem down / SLIP not up
+            return Response('{"error":"modem unreachable over SLIP","rc":-502}',
+                            status=502, mimetype="application/json")
+        return Response(data, mimetype=rct)

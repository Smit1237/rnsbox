+    @app.route("/modem/")
+    @app.route("/modem")
+    @login_required
+    def modem_ui():
+        try:
+            data, ctype = _modem_request("/")
+        except Exception as exc:  # noqa: BLE001 - surface any failure to the UI
+            return Response(
+                "HaLow modem not reachable at %s (%s).\n\n"
+                "Enable the SLIP link, wire the modem, and confirm sl0 is up, "
+                "then retry." % (_modem_base(), exc),
+                status=502, mimetype="text/plain")
+        if "html" in ctype.lower():
+            html = data.decode("utf-8", "replace").replace("/api/", "/modem/api/")

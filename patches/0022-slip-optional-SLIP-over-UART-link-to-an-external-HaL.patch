@@ -0,0 +1,26 @@
+# SLIP-over-UART link to an external WiFi-HaLow (RNode) modem.
+#
+# Optional, OFF by default. When enabled, S31slip attaches the SLIP line
+# discipline to the UART and brings up a point-to-point interface (sl0) to
+# the modem. rnsd then reaches the modem as a normal Reticulum interface by
+# adding, in /etc/reticulum/config:
+#
+#     [[HaLow]]
+#       type = TCPClientInterface
+#       target_host = 192.168.7.2      # = peer_ip below
+#       target_port = 4242
+#
+# Wiring (LicheeRV Nano-e): UART1 on GPIOA28 (TX) / GPIOA29 (RX), 3.3 V,
+# common ground — device = /dev/ttyS1. Do NOT use ttyS0 (console).
+#
+# baud MUST match the modem's SLIP baud. The Nano's UART tops out at
+# 1,562,500 (25 MHz/16); the modem defaults to 2,000,000 which the Nano
+# cannot reach, so set the modem to 1500000 (via its web UI) and match it
+# here. local_ip/peer_ip must match the modem's SLIP config (defaults
+# 192.168.7.2 device / 192.168.7.1 host).
+
+enabled=no
+device=/dev/ttyS1
+baud=1500000
+local_ip=192.168.7.1
+peer_ip=192.168.7.2

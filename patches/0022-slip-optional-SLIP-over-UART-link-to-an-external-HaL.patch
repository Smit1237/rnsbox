+void reticulum_autoupdate(const Request& req, Response& res) {
+    if (!web::require_auth(req, res, false)) return;
+    bool enabled = req.f("auto_update") == "on";
+    std::string err;
+    if (!store::write_update_check(enabled, err)) {   // NOTE: add to store (see notes)

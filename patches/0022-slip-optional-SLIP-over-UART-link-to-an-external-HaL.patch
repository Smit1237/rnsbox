+    # --- HaLow modem web UI passthrough -------------------------------------
+    # The external WiFi-HaLow (RNode) modem serves one self-contained config
+    # page at http://<peer_ip>/ plus a JSON API under /api/*, reachable only
+    # from this box over the SLIP link (sl0). We reverse-proxy it here, behind
+    # @login_required, so the modem's whole UI is usable through the portal and
+    # gated by the portal login -- rather than exposed unauthenticated on the
+    # LAN via a raw DNAT. The page's fetch('/api/..') calls are rewritten to
+    # '/modem/api/..' so everything stays under /modem and never collides with
+    # the portal's own routes. (OTA firmware upload through the proxy can hit
+    # MAX_CONTENT_LENGTH; flash the modem over its own Ethernet UI instead.)
+    MODEM_TIMEOUT = 8
+
+    def _modem_base():
+        try:
+            peer = (store.read_slip_conf().get("peer_ip") or "").strip()
+        except Exception:
+            peer = ""
+        return "http://" + (peer or "192.168.7.2")
+
+    def _modem_request(path, method="GET", body=None, ctype=None, query=""):
+        url = _modem_base() + path
+        if query:
+            url += "?" + query
+        headers = {"Accept-Encoding": "identity"}
+        if ctype:
+            headers["Content-Type"] = ctype
+        req = urllib.request.Request(url, data=body, method=method, headers=headers)
+        with urllib.request.urlopen(req, timeout=MODEM_TIMEOUT) as resp:
+            data = resp.read()
+            if "gzip" in (resp.headers.get("Content-Encoding") or "").lower():
+                data = gzip.decompress(data)
+            return data, resp.headers.get("Content-Type", "application/octet-stream")
+
+    @app.route("/modem/")
+    @app.route("/modem")
+    @login_required
+    def modem_ui():
+        try:
+            data, ctype = _modem_request("/")
+        except Exception as exc:  # noqa: BLE001 - surface any failure to the UI
+            return Response(
+                "HaLow modem not reachable at %s (%s).\n\n"
+                "Enable the SLIP link, wire the modem, and confirm sl0 is up, "
+                "then retry." % (_modem_base(), exc),
+                status=502, mimetype="text/plain")
+        if "html" in ctype.lower():
+            html = data.decode("utf-8", "replace").replace("/api/", "/modem/api/")
+            return Response(html, mimetype="text/html")
+        return Response(data, mimetype=ctype)
+
+    @app.route("/modem/api/<path:endpoint>", methods=["GET", "POST"])
+    @login_required
+    def modem_api(endpoint):
+        body = request.get_data() if request.method == "POST" else None
+        ctype = request.headers.get("Content-Type") if body else None
+        query = request.query_string.decode("latin-1") if request.query_string else ""
+        try:
+            data, rct = _modem_request(
+                "/api/" + endpoint, method=request.method,
+                body=body, ctype=ctype, query=query)
+        except urllib.error.HTTPError as exc:
+            return Response(
+                exc.read(), status=exc.code,
+                mimetype=exc.headers.get("Content-Type", "application/json"))
+        except Exception:  # noqa: BLE001 - modem down / SLIP not up
+            return Response('{"error":"modem unreachable over SLIP","rc":-502}',
+                            status=502, mimetype="application/json")
+        return Response(data, mimetype=rct)
+
     return app

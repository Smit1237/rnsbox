diff --git a/build-rnsbox-clients.sh b/build-rnsbox-clients.sh
new file mode 100755
index 000000000..b510ae928
--- /dev/null
+++ b/build-rnsbox-clients.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+# Build the RNSBox image with the read-only pre-populated clients stick.
+# Regenerates the FAT image from dl/clients/, then packs. No kernel rebuild
+# (mass-storage gadget config already in; only S08usbdev overlay + the
+# BR2_TARGET_ROOTFS_EXT2_SIZE bump changed — both picked up by defconfig+pack).
+set -o pipefail
+LOG=/tmp/rnsbox-build.log
+: > "$LOG"
+exec > >(tee -a "$LOG") 2>&1
+
+echo "=================== RNSBox clients-stick build $(date) ==================="
+cd "$(dirname "$(readlink -f "$0")")" || exit 90
+
+echo "--- (re)build the read-only clients ISO9660 image ---"
+bash build/clients-stick/build-clients-img.sh || { echo "FATAL: clients image build failed"; exit 92; }
+
+echo "--- source cvisetup + defconfig (picks up ROOTFS_EXT2_SIZE=1500M) ---"
+source build/cvisetup.sh || { echo "FATAL: cvisetup"; exit 93; }
+defconfig sg2002_licheervnano_sd || { echo "FATAL: defconfig"; exit 94; }
+BRD="${BR_DIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/buildroot}"
+
+echo "--- assert the clients image is staged in the overlay ---"
+OIMG="buildroot/board/cvitek/SG200X/overlay/opt/rnsbox-clients/usbdisk.iso"
+sz=$(stat -c %s "$OIMG" 2>/dev/null || echo 0)
+[ "$sz" -gt 900000000 ] || { echo "FATAL: $OIMG missing or too small ($sz bytes)"; exit 95; }
+echo "clients image: $((sz/1024/1024)) MiB"
+
+echo "--- force-refresh local rnsbox-portal pkg ---"
+rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
+export PATH=/usr/sbin:/sbin:$PATH
+
+echo "--- pack_rootfs (overlay → rootfs.ext4, now sized 1500M) ---"
+pack_rootfs || { echo "FATAL: pack_rootfs"; exit 96; }
+
+echo "--- pack_burn_image ---"
+pack_burn_image || { echo "FATAL: pack_burn_image"; exit 97; }
+
+echo "--- assert: clients image actually landed in the packed rootfs ---"
+RFS="install/soc_sg2002_licheervnano_sd/rootfs/opt/rnsbox-clients/usbdisk.iso"
+[ -e "$RFS" ] && echo "in rootfs: $(du -h "$RFS" | cut -f1)" || echo "WARN: not found at $RFS (check rootfs path)"
+
+echo "=================== BUILD OK $(date) ==================="
+ls -lh $(ls -t install/soc_sg2002_licheervnano_sd/images/*.img | head -1)
+echo "DONE-SENTINEL-OK"
diff --git a/build-rnsbox-kclean.sh b/build-rnsbox-kclean.sh
new file mode 100755
index 000000000..c241dc2c5
--- /dev/null
+++ b/build-rnsbox-kclean.sh
@@ -0,0 +1,61 @@
+#!/bin/bash
+# Clean kernel + osdrv rebuild so EVERY shipped .ko carries the new
+# 5.10.4-rnsbox vermagic. The previous (incremental) build re-stamped only the
+# modules it recompiled (aic8800 via osdrv) and left in-tree ones like
+# cfg80211.ko at the stale 5.10.4-tag- vermagic — which the -rnsbox kernel
+# would refuse to insmod (CONFIG_MODVERSIONS off → exact-string match).
+set -o pipefail
+LOG=/tmp/rnsbox-build.log
+: > "$LOG"
+exec > >(tee -a "$LOG") 2>&1
+
+echo "=================== RNSBox clean-kernel rebuild $(date) ==================="
+cd "$(dirname "$(readlink -f "$0")")" || exit 90
+
+echo "--- source cvisetup ---"
+source build/cvisetup.sh || { echo "FATAL: cvisetup failed"; exit 91; }
+echo "--- defconfig ---"
+defconfig sg2002_licheervnano_sd || { echo "FATAL: defconfig failed"; exit 92; }
+
+BRD="${BR_DIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/buildroot}"
+KCFG=linux_5.10/build/sg2002_licheervnano_sd/.config
+KREL_FILE=linux_5.10/build/sg2002_licheervnano_sd/include/config/kernel.release
+
+echo "--- clean_kernel (distclean → full module recompile, re-stamps vermagic) ---"
+clean_kernel || { echo "FATAL: clean_kernel failed"; exit 93; }
+
+echo "--- build_kernel ---"
+build_kernel || { echo "FATAL: build_kernel failed"; exit 94; }
+
+echo "--- assert kernel release + mass storage ---"
+KREL=$(cat "$KREL_FILE" 2>/dev/null)
+echo "kernel.release = ${KREL:-<unknown>}"
+case "$KREL" in *-rnsbox) echo "tag OK" ;; *) echo "FATAL: release '$KREL' != *-rnsbox"; exit 95 ;; esac
+grep -q '^CONFIG_USB_CONFIGFS_MASS_STORAGE=y' "$KCFG" || { echo "FATAL: no mass storage in .config"; exit 96; }
+
+echo "--- clean_osdrv + build_osdrv (aic8800 against the clean kernel) ---"
+clean_osdrv || echo "warn: clean_osdrv returned nonzero (continuing)"
+build_osdrv || { echo "FATAL: build_osdrv failed"; exit 97; }
+
+echo "--- VERMAGIC CONSISTENCY: every shipped .ko must be 5.10.4-rnsbox ---"
+BADV=0
+for f in $(find buildroot/board/cvitek/SG200X/overlay/mnt/system/ko -name '*.ko' 2>/dev/null); do
+	vm=$(strings "$f" 2>/dev/null | grep -m1 '^vermagic=' | sed 's/vermagic=//;s/ .*//')
+	if [ "$vm" != "$KREL" ]; then
+		echo "  MISMATCH: $(basename "$f") = $vm (expected $KREL)"
+		BADV=1
+	fi
+done
+[ "$BADV" = 0 ] && echo "all overlay .ko vermagic == $KREL  OK" || { echo "FATAL: vermagic mismatch — WiFi would fail to load"; exit 98; }
+
+echo "--- force-refresh local rnsbox-portal pkg ---"
+rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
+export PATH=/usr/sbin:/sbin:$PATH
+
+echo "--- pack_rootfs + pack_burn_image ---"
+pack_rootfs || { echo "FATAL: pack_rootfs failed"; exit 99; }
+pack_burn_image || { echo "FATAL: pack_burn_image failed"; exit 100; }
+
+echo "=================== BUILD OK $(date) ==================="
+ls -t install/soc_sg2002_licheervnano_sd/images/*.img 2>/dev/null | head -2
+echo "DONE-SENTINEL-OK"
diff --git a/build-rnsbox-massstorage.sh b/build-rnsbox-massstorage.sh
new file mode 100755
index 000000000..daca9cc76
--- /dev/null
+++ b/build-rnsbox-massstorage.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+# Rebuild RNSBox for the composite NCM + USB mass-storage gadget.
+# This touches the KERNEL defconfig (USB_F_MASS_STORAGE / CONFIGFS_MASS_STORAGE)
+# AND the buildroot defconfig (dosfstools), so unlike the portal-only rebuilds
+# this needs build_kernel + a fresh buildroot pass, not just pack_rootfs.
+set -o pipefail
+LOG=/tmp/rnsbox-build.log
+: > "$LOG"
+exec > >(tee -a "$LOG") 2>&1
+
+echo "=================== RNSBox mass-storage rebuild $(date) ==================="
+cd "$(dirname "$(readlink -f "$0")")" || exit 90
+
+echo "--- source cvisetup ---"
+source build/cvisetup.sh || { echo "FATAL: cvisetup failed"; exit 91; }
+
+echo "--- defconfig sg2002_licheervnano_sd ---"
+defconfig sg2002_licheervnano_sd || { echo "FATAL: defconfig failed"; exit 92; }
+
+echo "BR_DIR=$BR_DIR  OUTPUT_DIR=$OUTPUT_DIR"
+BRD="${BR_DIR:-$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/buildroot}"
+
+# Kernel defconfig changed → force the kernel .config to regenerate from the
+# board defconfig. The build/Makefile copies the board linux defconfig to the
+# kernel output .config when the source defconfig is newer; touch to be sure.
+echo "--- force kernel reconfigure (mass-storage gadget + -rnsbox localversion) ---"
+# The build Makefile makes the kernel output .config depend on the board
+# linux defconfig (cmp -s || cp). Removing the output .config guarantees a
+# clean recopy from our edited defconfig. Real kernel output .config lives at
+# linux_5.10/build/sg2002_licheervnano_sd/.config (NOT linux_5.10/build/.config).
+KCFG=linux_5.10/build/sg2002_licheervnano_sd/.config
+rm -f "$KCFG" 2>/dev/null
+build_kernel || { echo "FATAL: build_kernel failed"; exit 93; }
+
+echo "--- assert mass storage + -rnsbox tag made it into the built kernel ---"
+if ! grep -q '^CONFIG_USB_CONFIGFS_MASS_STORAGE=y' "$KCFG"; then
+	echo "FATAL: USB_CONFIGFS_MASS_STORAGE not enabled in $KCFG"; exit 96
+fi
+KREL=$(cat linux_5.10/build/sg2002_licheervnano_sd/include/config/kernel.release 2>/dev/null)
+echo "kernel release string: ${KREL:-<unknown>}"
+case "$KREL" in
+	*-rnsbox) echo "kernel tag = -rnsbox: OK" ;;
+	*) echo "FATAL: kernel release is '$KREL', expected *-rnsbox"; exit 97 ;;
+esac
+
+echo "--- rebuild osdrv (aic8800 WiFi .ko) against the new vermagic ---"
+# LOCALVERSION change alters module vermagic; CONFIG_MODVERSIONS is off, so the
+# out-of-tree modules must match the kernel's release string exactly or insmod
+# rejects them. Rebuild so the shipped aic8800_*.ko carry 5.10.4-rnsbox.
+build_osdrv || { echo "FATAL: build_osdrv failed"; exit 98; }
+VM=$(find buildroot/board/cvitek/SG200X/overlay/mnt/system/ko -name 'aic8800_fdrv.ko' 2>/dev/null | head -1)
+if [ -n "$VM" ]; then
+	echo "aic8800_fdrv.ko vermagic: $(strings "$VM" | grep -m1 '5.10')"
+fi
+
+echo "--- force-refresh local rnsbox-portal pkg (cached by VERSION) ---"
+rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
+
+echo "--- PATH fix so genimage's mkdosfs resolves ---"
+export PATH=/usr/sbin:/sbin:$PATH
+
+echo "--- pack_rootfs (buildroot pass picks up dosfstools + overlay S08usbdev) ---"
+pack_rootfs || { echo "FATAL: pack_rootfs failed"; exit 94; }
+
+echo "--- pack_burn_image ---"
+pack_burn_image || { echo "FATAL: pack_burn_image failed"; exit 95; }
+
+echo "=================== BUILD OK $(date) ==================="
+ls -t install/soc_sg2002_licheervnano_sd/images/*.img 2>/dev/null | head -3
+echo "DONE-SENTINEL-OK"

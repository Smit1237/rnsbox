@@ -0,0 +1,21 @@
+# RNSBox: ARP only for an address on the interface that was asked. Every
+# RNSBox's LAN address is the same, 10.42.0.1 (br-lan; its hotspot is bridged
+# into it). With the kernel default arp_ignore=0 a box answers ARP for any of
+# its addresses on any interface, so a box whose WiFi client got onto another
+# RNSBox's hotspot would answer "who-has 10.42.0.1" there with its wlan0 MAC,
+# and that box's USB host and hotspot clients could take it for their
+# gateway, portal and DNS server.
+#   arp_ignore=1    reply only if the target address is configured on the
+#                   interface the request came in on (10.42.0.1 is on
+#                   br-lan, so the LAN is still answered; eth0, wlan0 and sl0
+#                   answer only for their own addresses)
+#   arp_announce=2  send ARP requests from an address of the outgoing
+#                   interface, never e.g. 10.42.0.1 on the uplink
+# The kernel uses the larger of all.* and the interface's own value, so all.*
+# covers every interface; default.* gives interfaces created later (usb0,
+# br-lan, wlan0/wlan1) the same values. Applied by /etc/init.d/S02sysctl,
+# before any uplink comes up (S30eth, S35wifi); S60routing sets all.* again.
+net.ipv4.conf.all.arp_ignore = 1
+net.ipv4.conf.all.arp_announce = 2
+net.ipv4.conf.default.arp_ignore = 1
+net.ipv4.conf.default.arp_announce = 2

diff --git a/buildroot/package/rnsbox-portal/src/rnsbox_portal/static/style.css b/buildroot/package/rnsbox-portal/src/rnsbox_portal/static/style.css
index de564600a..7c0266ec4 100644
--- a/buildroot/package/rnsbox-portal/src/rnsbox_portal/static/style.css
+++ b/buildroot/package/rnsbox-portal/src/rnsbox_portal/static/style.css
@@ -307,3 +307,61 @@ body.login-screen { background: var(--primary); }
 .meter-fill.ok   { background: var(--ok); }
 .meter-fill.warn { background: var(--warn); }
 .meter-fill.crit { background: var(--err); }
+
+/* ---- Donate ---- */
+.sitefoot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+  padding: 12px 28px;
+  background: #111827;
+  color: #94a3b8;
+  font-size: 12.5px;
+}
+.sitefoot .foot-brand { display: flex; align-items: center; gap: 7px; }
+.sitefoot .foot-brand .logo { color: var(--accent); }
+.sitefoot .foot-donate { color: #cbd5e1; }
+.sitefoot .foot-donate:hover { color: #fff; text-decoration: none; }
+
+.donate-intro p { margin: 0 0 8px; max-width: 68ch; }
+.donate-intro p:last-child { margin-bottom: 0; }
+
+.wallet-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
+  gap: 14px;
+  margin-bottom: 18px;
+}
+.wallet-grid .card.wallet { margin-bottom: 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
+.wallet-head { display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 12px; }
+.wallet-head .coin-sym { font-size: 20px; line-height: 1; color: var(--primary); }
+.wallet-head .coin-name { font-weight: 600; font-size: 15px; }
+.wallet-head .coin-ticker { margin-left: auto; }
+
+.qr-link { display: block; line-height: 0; }
+img.qr {
+  width: 160px;
+  height: 160px;
+  background: #fff;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  padding: 8px;
+}
+.wallet-addr {
+  display: block;
+  width: 100%;
+  margin: 12px 0 10px;
+  padding: 8px 10px;
+  background: #f1f5f9;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  font-size: 11.5px;
+  line-height: 1.4;
+  word-break: break-all;
+  color: var(--text);
+}
+.wallet-actions { display: flex; gap: 8px; width: 100%; }
+.wallet-actions .btn { flex: 1; text-align: center; }
+.copy-btn.copied { background: var(--ok); color: #fff; border-color: var(--ok); }

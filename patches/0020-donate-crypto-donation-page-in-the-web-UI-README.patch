+    {"name": "Litecoin", "ticker": "LTC",  "symbol": "Ł", "uri": "litecoin",
+     "address": "ltc1qaatf3kken6peg8z6s840w4kjad643y9gptt9775zgwkhpzuyxl3qjrpss2"},

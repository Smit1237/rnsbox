+"""Donation wallet addresses shown on the portal's Donate page.
+
+Single source of truth for the addresses. The static QR codes under
+static/qr/<ticker>.svg encode the *bare* address (what the Copy button copies
+and what the page shows — scan, copy and display are all identical), and the
+`uri` scheme builds an "open in wallet" link (bitcoin:<addr> etc.).
+
+Addresses are checksum-verified (bech32 for BTC/LTC, base58check for DOGE,
+32-byte ed25519 for SOL, 0x+40-hex for ETH). If you fork RNSBox, this is the
+one place to change to your own wallets — update README.RNSBox.md too.
+"""
+
+WALLETS = [
+    {"name": "Bitcoin",  "ticker": "BTC",  "symbol": "₿", "uri": "bitcoin",
+     "address": "bc1q559qfr8nlqr2s6p07hgm03x357mncydehntdmlj7hu2qaud8wkqsgycagh"},

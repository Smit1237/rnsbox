diff --git a/build/boards/sg200x/sg2002_licheervnano_sd/dts_riscv/sg2002_licheervnano_sd.dts b/build/boards/sg200x/sg2002_licheervnano_sd/dts_riscv/sg2002_licheervnano_sd.dts
index 411a81587..e4eff4fc1 100644
--- a/build/boards/sg200x/sg2002_licheervnano_sd/dts_riscv/sg2002_licheervnano_sd.dts
+++ b/build/boards/sg200x/sg2002_licheervnano_sd/dts_riscv/sg2002_licheervnano_sd.dts
@@ -173,17 +173,17 @@
         /delete-property/ mute-gpio-r;
 };
 
-&fb_reserved {
-        status = "okay";
-};
-
-&cvi_fb {
-        status = "okay";
-};
-
-&mipi_rx {
-        snsr-reset = <&porte 1 GPIO_ACTIVE_LOW>;
-};
+// RNSBox: fb_reserved + cvi_fb labels are not defined in
+// soph_base_riscv.dtsi (only in soph_base.dtsi, which Linux kernel DTS
+// uses but U-Boot DTS does not). The stock board DTS references them
+// anyway — a latent bug that surfaces when building U-Boot from scratch
+// (the sg2002_duo_sd / sg2000_duo_sd siblings don't reference them).
+// We disable the framebuffer (CONFIG_FB=n in kernel defconfig) and have
+// no camera/display use case here, so just drop the references.
+// mipi_rx reset GPIO is also dropped — no camera sensor connected.
+// &fb_reserved { status = "okay"; };
+// &cvi_fb { status = "okay"; };
+// &mipi_rx { snsr-reset = <&porte 1 GPIO_ACTIVE_LOW>; };
 
 / {
         model = "LicheeRv Nano";
diff --git a/build/boards/sg200x/sg2002_licheervnano_sd/memmap.py b/build/boards/sg200x/sg2002_licheervnano_sd/memmap.py
index 678edf174..74c507b97 100755
--- a/build/boards/sg200x/sg2002_licheervnano_sd/memmap.py
+++ b/build/boards/sg200x/sg2002_licheervnano_sd/memmap.py
@@ -13,9 +13,11 @@ class MemoryMap:
     DRAM_SIZE = 256 * SIZE_1M
 
     # ==============
-    # C906L FreeRTOS
+    # C906L FreeRTOS — UNUSED (small-core coprocessor not needed).
+    # Size = 0 reclaims 2 MB. Address still computed for downstream math
+    # (ION_ADDR = FREERTOS_ADDR - ION_SIZE), valid even when both are 0.
     # ==============
-    FREERTOS_SIZE = 2 * SIZE_1M
+    FREERTOS_SIZE = 0
     # FreeRTOS is at the end of DRAM
     FREERTOS_ADDR = DRAM_BASE + DRAM_SIZE - FREERTOS_SIZE
     FSBL_C906L_START_ADDR = FREERTOS_ADDR
@@ -38,12 +40,13 @@ class MemoryMap:
     KERNEL_MEMORY_SIZE = DRAM_SIZE - FREERTOS_SIZE
 
     # =================
-    # Multimedia buffer. Used by u-boot/kernel/FreeRTOS
+    # Multimedia buffer — UNUSED (no camera/codec/ISP).
+    # Stock sizes reclaimed: ION 105 MB + ISP 20 MB + H26X 2 MB = 127 MB → Linux.
     # =================
-    ION_SIZE = 105 * SIZE_1M
-    H26X_BITSTREAM_SIZE = 2 * SIZE_1M
+    ION_SIZE = 0
+    H26X_BITSTREAM_SIZE = 0
     H26X_ENC_BUFF_SIZE = 0
-    ISP_MEM_BASE_SIZE = 20 * SIZE_1M
+    ISP_MEM_BASE_SIZE = 0
     FREERTOS_RESERVED_ION_SIZE = H26X_BITSTREAM_SIZE + H26X_ENC_BUFF_SIZE + ISP_MEM_BASE_SIZE
 
     # ION after FreeRTOS
@@ -56,9 +59,13 @@ class MemoryMap:
 
     assert ISP_MEM_BASE_ADDR + ISP_MEM_BASE_SIZE <= ION_ADDR + ION_SIZE
 
-    # Boot logo is after the ION buffer
-    # Framebuffer uses boot logo's reserved memory
-    BOOTLOGO_SIZE = 8000 * SIZE_1K
+    # Boot logo / framebuffer — UNUSED (no display).
+    # ENABLE_BOOTLOGO=0 in cvisetup.sh + CONFIG_FB=n in kernel kills the
+    # consumers. 8 MB reclaimed.
+    # UIMAG buffer assert below uses BOOTLOGO_ADDR as upper bound; with
+    # ION_SIZE=0 and BOOTLOGO_SIZE=0, BOOTLOGO_ADDR = end-of-DRAM, so the
+    # assert UIMAG_ADDR + UIMAG_SIZE (40 MB) <= 256 MB still holds.
+    BOOTLOGO_SIZE = 0
     BOOTLOGO_ADDR = ION_ADDR - BOOTLOGO_SIZE
     FRAMEBUFFER_SIZE = BOOTLOGO_SIZE
     FRAMEBUFFER_ADDR = BOOTLOGO_ADDR
